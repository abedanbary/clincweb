{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ClinicApp.Web && dotnet publish -c Release -o /app/out"
  },
  "deploy": {
    "startCommand": "dotnet /app/out/ClinicApp.Web.dll",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
