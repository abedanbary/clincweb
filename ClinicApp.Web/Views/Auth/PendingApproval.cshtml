@{
    ViewData["Title"] = "Access Pending";
    Layout = null;
    var email     = ViewBag.Email     as string ?? "";
    var firstName = ViewBag.FirstName as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access pending — DentalTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dentaltrack.css" asp-append-version="true" />
    <style>
        body { margin: 0; }

        .dt-wrap {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 40px 56px;
            background: #fff;
        }

        .dt-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dt-logo {
            font: 800 15px/1 var(--dt-font);
            letter-spacing: -.02em;
            color: var(--dt-ink);
        }

        .dt-logo span { color: var(--dt-green); }

        .dt-note {
            font: 600 12px var(--dt-font);
            color: var(--dt-text-soft);
        }

        .dt-main {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
            max-width: 1180px;
            width: 100%;
            margin: 0 auto;
            padding: 56px 0;
        }

        .dt-h1 {
            font: 800 44px/1.06 var(--dt-font);
            letter-spacing: -.04em;
            color: var(--dt-ink);
            margin: 26px 0 0;
            text-wrap: balance;
        }

        .dt-lede {
            font: 500 14px/1.7 var(--dt-font);
            color: var(--dt-text-muted);
            margin: 18px 0 0;
            max-width: 34ch;
        }

        .dt-panel { max-width: 420px; width: 100%; }

        .dt-email {
            border-bottom: 1.5px solid var(--dt-ink);
            padding-bottom: 10px;
            font: 700 15px var(--dt-font);
            color: var(--dt-ink);
            word-break: break-all;
        }

        .dt-steps {
            margin-top: 28px;
            padding-left: 3px;
            border-left: 2px solid var(--dt-border);
        }

        .dt-step {
            padding: 0 0 18px 16px;
            font: 500 13px/1.7 var(--dt-font);
            color: var(--dt-text-muted);
        }

        .dt-step:last-child { padding-bottom: 0; }
        .dt-step strong { color: var(--dt-ink); font-weight: 700; }

        .dt-footer {
            border-top: 1px solid var(--dt-border);
            padding-top: 18px;
            font: 500 11.5px var(--dt-font);
            color: var(--dt-text-faint);
        }

        @@media (max-width: 860px) {
            .dt-wrap { padding: 28px 24px; }
            .dt-main { grid-template-columns: 1fr; gap: 44px; padding: 48px 0; }
            .dt-h1 { font-size: 32px; }
        }
    </style>
</head>
<body>
    <div class="dt-wrap">
        <header class="dt-header">
            <div class="dt-logo">Dental<span>Track</span></div>
            <div class="dt-note">Clinic portal</div>
        </header>

        <main class="dt-main">
            <div>
                <div class="dt-rule"></div>
                <h1 class="dt-h1">Your access is pending.</h1>
                @if (!string.IsNullOrEmpty(firstName))
                {
                    <p class="dt-lede">Hi @firstName — we verified your Google account, but it isn't linked to a clinic yet.</p>
                }
                else
                {
                    <p class="dt-lede">We verified your Google account, but it isn't linked to a clinic yet.</p>
                }
            </div>

            <div class="dt-panel">
                @if (!string.IsNullOrEmpty(email))
                {
                    <span class="dt-label">Verified account</span>
                    <div class="dt-email">@email</div>
                }

                <div class="dt-steps">
                    <div class="dt-step"><strong>Send this address</strong> to your clinic administrator.</div>
                    <div class="dt-step"><strong>They add your account</strong> with the right role and clinic.</div>
                    <div class="dt-step"><strong>Sign in again</strong> once they confirm.</div>
                </div>

                <a class="dt-btn-ghost" href="/Auth/Login" style="margin-top:30px">Back to sign in</a>
            </div>
        </main>

        <footer class="dt-footer">DentalTrack · Privacy · Support</footer>
    </div>
</body>
</html>
