@{
    ViewData["Title"] = "Access Pending";
    Layout = null;
    var email     = ViewBag.Email     as string ?? "";
    var firstName = ViewBag.FirstName as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Pending — Clinic Management</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
            padding: 56px 48px;
            max-width: 480px;
            width: 100%;
            text-align: center;
            animation: pop 0.4s ease-out;
        }

        @@keyframes pop {
            from { transform: scale(0.95); opacity: 0; }
            to   { transform: scale(1);    opacity: 1; }
        }

        .icon { font-size: 64px; margin-bottom: 24px; }

        h1 {
            font-size: 24px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 12px;
        }

        .subtitle {
            font-size: 15px;
            color: #64748b;
            line-height: 1.6;
            margin-bottom: 28px;
        }

        .email-pill {
            display: inline-block;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
            padding: 6px 14px;
            border-radius: 99px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 28px;
        }

        .info-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 16px 20px;
            text-align: left;
            margin-bottom: 28px;
            font-size: 13px;
            color: #475569;
            line-height: 1.7;
        }

        .info-box strong { color: #1e293b; }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            color: #475569;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.15s;
        }

        .btn-back:hover { background: #e2e8f0; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">🔒</div>
        <h1>Access Pending</h1>

        @if (!string.IsNullOrEmpty(firstName))
        {
            <p class="subtitle">Hi <strong>@firstName</strong>, your Google account was verified but you don't have access to this system yet.</p>
        }
        else
        {
            <p class="subtitle">Your Google account was verified but you don't have access to this system yet.</p>
        }

        @if (!string.IsNullOrEmpty(email))
        {
            <div class="email-pill">@email</div>
        }

        <div class="info-box">
            <strong>What to do next:</strong><br />
            Contact your clinic administrator and provide them with your Google email address above.<br /><br />
            The administrator will add your account with the correct role and clinic assignment.
        </div>

        <a href="/Auth/Login" class="btn-back">← Back to Sign In</a>
    </div>
</body>
</html>
