@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Clinic Management</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            max-width: 900px;
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            animation: slideInDown 0.5s ease-out;
        }

        @@keyframes slideInDown {
            from { transform: translateY(-20px); opacity: 0; }
            to   { transform: translateY(0);     opacity: 1; }
        }

        /* ── Left branding panel ── */
        .login-left {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            padding: 60px 40px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .login-icon { font-size: 80px; margin-bottom: 30px; }
        .login-left h1 { font-size: 32px; margin-bottom: 16px; font-weight: 700; }
        .login-left p  { font-size: 15px; opacity: 0.9; line-height: 1.6; }

        /* ── Right sign-in panel ── */
        .login-right {
            padding: 48px 48px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-header { text-align: center; margin-bottom: 28px; }
        .login-header h2 { color: #1e293b; font-size: 24px; font-weight: 700; margin-bottom: 6px; }
        .login-header p  { color: #64748b; font-size: 14px; }

        /* ── Error banner ── */
        .alert-error {
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: #991b1b;
            padding: 10px 14px;
            border-radius: 8px;
            margin-bottom: 18px;
            font-size: 13px;
            text-align: center;
        }

        /* ── Local login form ── */
        .form-field { display: flex; flex-direction: column; gap: 4px; margin-bottom: 14px; }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #374151;
        }

        .form-input {
            padding: 10px 14px;
            border: 1.5px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            color: #111827;
            transition: border-color 0.15s;
            outline: none;
        }

        .form-input:focus { border-color: #6366f1; }

        .btn-login {
            width: 100%;
            padding: 12px;
            background: #6366f1;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s;
            margin-top: 4px;
        }

        .btn-login:hover  { background: #4f46e5; }
        .btn-login:active { transform: scale(0.99); }

        /* ── Divider ── */
        .divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 20px 0;
            color: #94a3b8;
            font-size: 12px;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }

        /* ── Google button ── */
        .btn-google {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 11px 20px;
            background: #ffffff;
            color: #3c4043;
            border: 1.5px solid #dadce0;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.15s;
            box-shadow: 0 1px 4px rgba(0,0,0,0.07);
        }

        .btn-google:hover {
            background: #f8fafc;
            border-color: #1a73e8;
            box-shadow: 0 3px 10px rgba(26,115,232,0.15);
        }

        .btn-google svg { flex-shrink: 0; }

        /* ── Footer note ── */
        .login-footer {
            margin-top: 24px;
            text-align: center;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.7;
        }

        /* ── Responsive ── */
        @@media (max-width: 768px) {
            .login-container { grid-template-columns: 1fr; }
            .login-left { display: none; }
            .login-right { padding: 40px 28px; }
        }
    </style>
</head>
<body>
    <div class="login-container">

        <!-- Left: Branding -->
        <div class="login-left">
            <div class="login-icon">🦷</div>
            <h1>Clinic Management System</h1>
            <p>Manage your dental clinic efficiently with our comprehensive management solution</p>
        </div>

        <!-- Right: Sign in -->
        <div class="login-right">
            <div class="login-header">
                <h2>Welcome Back</h2>
                <p>Sign in to access the clinic portal</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert-error">@TempData["Error"]</div>
            }

            <!-- Local email/password form -->
            <form method="post" asp-action="Login" asp-controller="Auth">
                @Html.AntiForgeryToken()
                <div class="form-field">
                    <label class="form-label" for="email">Email</label>
                    <input class="form-input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required />
                </div>
                <div class="form-field">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-input" type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn-login">Sign In</button>
            </form>

            <div class="divider">or</div>

            <!-- Google Sign-In -->
            <a href="/Auth/ExternalLogin?provider=Google" class="btn-google">
                <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    <path fill="none" d="M0 0h48v48H0z"/>
                </svg>
                Sign in with Google
            </a>

            <div class="login-footer">
                Access is restricted to authorized clinic staff.<br />
                Contact your administrator if you need access.
            </div>
        </div>

    </div>
</body>
</html>
