@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — DentalTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: #fff;
            font-family: Manrope, system-ui, sans-serif;
            color: #1a1a1a;
            -webkit-font-smoothing: antialiased;
        }

        a { color: #174d39; }
        a:hover { color: #0f3628; }

        /* ── Page frame ── */
        .dt-wrap {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 40px 56px;
            background: #fff;
        }

        .dt-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dt-logo {
            font: 800 15px/1 Manrope, sans-serif;
            letter-spacing: -.02em;
            color: #1a1a1a;
        }

        .dt-logo span { color: #174d39; }

        .dt-eyebrow {
            font: 600 12px Manrope, sans-serif;
            color: #8a938f;
        }

        .dt-main {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
            max-width: 1180px;
            width: 100%;
            margin: 0 auto;
            padding: 56px 0;
        }

        /* ── Left column ── */
        .dt-rule {
            width: 34px;
            height: 3px;
            background: #174d39;
        }

        .dt-h1 {
            font: 800 44px/1.06 Manrope, sans-serif;
            letter-spacing: -.04em;
            color: #1a1a1a;
            margin: 26px 0 0;
            text-wrap: balance;
        }

        .dt-lede {
            font: 500 14px/1.7 Manrope, sans-serif;
            color: #7c8581;
            margin: 18px 0 0;
            max-width: 32ch;
        }

        /* ── Form column ── */
        .dt-form {
            max-width: 420px;
            width: 100%;
        }

        .dt-sr {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
        }

        .dt-input {
            width: 100%;
            height: 52px;
            border: 0;
            border-bottom: 1.5px solid #1a1a1a;
            background: none;
            font: 500 15px Manrope, sans-serif;
            color: #1a1a1a;
            padding: 0;
            transition: border-color .15s;
        }

        .dt-input + .dt-input { margin-top: 16px; }
        .dt-input:focus { outline: none; border-bottom-color: #174d39; }
        .dt-input::placeholder { color: #a2aaa6; }

        .dt-submit {
            width: 100%;
            height: 52px;
            margin-top: 30px;
            border: 0;
            background: #174d39;
            color: #fff;
            font: 700 14.5px Manrope, sans-serif;
            cursor: pointer;
            transition: background .15s;
        }

        .dt-submit:hover { background: #0f3628; }

        .dt-google {
            width: 100%;
            height: 52px;
            margin-top: 10px;
            border: 1.5px solid #1a1a1a;
            background: #fff;
            color: #1a1a1a;
            font: 600 14px Manrope, sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
            transition: background .15s, color .15s;
        }

        .dt-google:hover { background: #1a1a1a; color: #fff; }
        .dt-google svg { flex-shrink: 0; }

        .dt-forgot {
            display: inline-block;
            margin-top: 22px;
            font: 600 12.5px Manrope, sans-serif;
            color: #174d39;
            text-decoration: none;
        }

        .dt-hint {
            font: 500 12px/1.6 Manrope, sans-serif;
            color: #7c8581;
            margin: 10px 0 0;
        }

        /* ── Error banner ── */
        .dt-error {
            border-left: 3px solid #b4321f;
            background: #fdf3f1;
            color: #8f2718;
            padding: 12px 14px;
            margin: 0 0 24px;
            font: 600 12.5px/1.5 Manrope, sans-serif;
        }

        /* ── Footer ── */
        .dt-footer {
            border-top: 1px solid #eceeed;
            padding-top: 18px;
            font: 500 11.5px Manrope, sans-serif;
            color: #a2aaa6;
        }

        @@media (max-width: 860px) {
            .dt-wrap { padding: 28px 24px; }
            .dt-main {
                grid-template-columns: 1fr;
                gap: 44px;
                padding: 48px 0;
            }
            .dt-h1 { font-size: 32px; }
        }
    </style>
</head>
<body>
    <div class="dt-wrap">
        <header class="dt-header">
            <div class="dt-logo">Dental<span>Track</span></div>
            <div class="dt-eyebrow">Clinic portal</div>
        </header>

        <main class="dt-main">
            <div>
                <div class="dt-rule"></div>
                <h1 class="dt-h1">Sign in to your clinic.</h1>
                <p class="dt-lede">Access is limited to authorized staff. Contact your administrator for an invite.</p>
            </div>

            <div class="dt-form">
                @if (TempData["Error"] != null)
                {
                    <div class="dt-error" role="alert">@TempData["Error"]</div>
                }

                <form method="post" asp-action="Login" asp-controller="Auth">
                    @Html.AntiForgeryToken()

                    <label class="dt-sr" for="dt-email">Email</label>
                    <input class="dt-input" id="dt-email" name="email" type="email" placeholder="Email" autocomplete="email" required />

                    <label class="dt-sr" for="dt-pass">Password</label>
                    <input class="dt-input" id="dt-pass" name="password" type="password" placeholder="Password" autocomplete="current-password" required />

                    <button type="submit" class="dt-submit">Sign in</button>
                </form>

                <a class="dt-google" href="/Auth/ExternalLogin?provider=Google">
                    <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z" />
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z" />
                        <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z" />
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z" />
                    </svg>
                    Continue with Google
                </a>

                <a class="dt-forgot" href="#" id="dt-forgot">Forgot password?</a>
                <p class="dt-hint" id="dt-hint" hidden>Contact your clinic administrator to reset your password.</p>
            </div>
        </main>

        <footer class="dt-footer">DentalTrack · Privacy · Support</footer>
    </div>

    <script>
        document.getElementById('dt-forgot').addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('dt-hint').hidden = false;
        });
    </script>
</body>
</html>
