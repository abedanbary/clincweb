@using ClinicApp.Web.ViewModels
@using ClinicApp.Web.Models
@model PatientsPageViewModel

@using System.Security.Claims
@{
    var userRole = User.FindFirstValue(ClaimTypes.Role);
    Layout = userRole == "Doctor" ? "_DoctorLayout" : "_ManagerLayout";
    ViewData["Title"] = "Patients";
}

<link rel="stylesheet" href="~/css/patients.css" />

<div class="patients-page">

    <!-- Header -->
    <header class="patients-header">
        <div class="patients-header-text">
            <h1 class="patients-title">Patients</h1>
            <p class="patients-subtitle">
                Manage patient records, medical history, and contact information.
            </p>
        </div>

        <div style="display: flex; gap: 12px; align-items: center;">
            <!-- Search Bar -->
            <div class="patients-search-bar">
                <span class="patients-search-icon">🔍</span>
                <input 
                    type="text" 
                    class="patients-search-input" 
                    id="searchInput"
                    placeholder="Search by name, phone, or ID..." 
                    onkeyup="searchPatients()"
                />
            </div>

            <button class="btn-primary">
                Add Patient
            </button>
        </div>
    </header>

    <!-- Main grid: table + form -->
    <section class="patients-grid">

        <!-- Left side: table -->
        <div class="patients-card patients-table-card">
            <div class="patients-card-header">
                <div>
                    <h2 class="patients-card-title">Patient Records</h2>
                    <p class="patients-card-caption">
                        <span id="patientCount">@Model.Patients.Count</span> patient(s) registered
                    </p>
                </div>
            </div>

            <div class="patients-table-wrapper">
                <table class="patients-table" id="patientsTable">
                    <thead>
                        <tr>
                            <th>ID Number</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Patients.Any())
                        {
                            foreach (var patient in Model.Patients)
                            {
                                var age = DateTime.Now.Year - patient.DateOfBirth.Year;
                                var genderClass = patient.Gender.ToLower() == "male" ? "badge-male" : "badge-female";

                                <tr class="patient-row">
                                    <td>@(patient.IdNumber ?? "-")</td>
                                    <td>@patient.FirstName @patient.LastName</td>
                                    <td>@patient.Phone</td>
                                    <td>@age</td>
                                    <td>
                                        <span class="badge @genderClass">@patient.Gender</span>
                                    </td>
                                    <td>
                                        <!-- رابط للـ Profile -->
                                        <a asp-action="Profile" asp-route-id="@patient.Id" class="btn-ghost">
                                             View
                                        </a>
                                        
                                        <button class="btn-ghost" onclick="editPatient(@patient.Id)"> Edit</button>
                                        
                                        @if (User.IsInRole("Manager"))
                                        {
                                            <form asp-action="Delete" asp-route-id="@patient.Id" method="post" style="display: inline;" onsubmit="return confirm('Delete this patient? This action cannot be undone.')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-ghost btn-danger">Delete</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">No patients found for this clinic yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right side: form -->
        <div class="patients-card patients-form-card">
            <div class="patients-card-header">
                <div>
                    <h2 class="patients-card-title">Patient Details</h2>
                    <p class="patients-card-caption">Add new patient to your clinic.</p>
                </div>
            </div>

            <form asp-action="Add" asp-controller="Patients" method="post" class="patients-form">
                @Html.AntiForgeryToken()

                <div class="patients-field">
                    <label class="patients-label" asp-for="NewPatient.IdNumber"></label>
                    <input class="patients-input" asp-for="NewPatient.IdNumber" placeholder="Optional" />
                    <span class="patients-error" asp-validation-for="NewPatient.IdNumber"></span>
                </div>

                <div class="patients-field-row">
                    <div class="patients-field">
                        <label class="patients-label" asp-for="NewPatient.FirstName"></label>
                        <input class="patients-input" asp-for="NewPatient.FirstName" />
                        <span class="patients-error" asp-validation-for="NewPatient.FirstName"></span>
                    </div>

                    <div class="patients-field">
                        <label class="patients-label" asp-for="NewPatient.LastName"></label>
                        <input class="patients-input" asp-for="NewPatient.LastName" />
                        <span class="patients-error" asp-validation-for="NewPatient.LastName"></span>
                    </div>
                </div>

                <div class="patients-field-row">
                    <div class="patients-field">
                        <label class="patients-label" asp-for="NewPatient.Phone"></label>
                        <input class="patients-input" asp-for="NewPatient.Phone" type="tel" />
                        <span class="patients-error" asp-validation-for="NewPatient.Phone"></span>
                    </div>

                    <div class="patients-field">
                        <label class="patients-label" asp-for="NewPatient.Email"></label>
                        <input class="patients-input" asp-for="NewPatient.Email" type="email" placeholder="Optional" />
                        <span class="patients-error" asp-validation-for="NewPatient.Email"></span>
                    </div>
                </div>

                <div class="patients-field-row">
                    <div class="patients-field">
                        <label class="patients-label" asp-for="NewPatient.DateOfBirth"></label>
                        <input class="patients-input" asp-for="NewPatient.DateOfBirth" type="date" />
                        <span class="patients-error" asp-validation-for="NewPatient.DateOfBirth"></span>
                    </div>

                    <div class="patients-field">
                        <label class="patients-label" asp-for="NewPatient.Gender"></label>
                        <select class="patients-select" asp-for="NewPatient.Gender">
                            <option value="">Select gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span class="patients-error" asp-validation-for="NewPatient.Gender"></span>
                    </div>
                </div>

                <div class="patients-field">
                    <label class="patients-label" asp-for="NewPatient.Address"></label>
                    <input class="patients-input" asp-for="NewPatient.Address" placeholder="Optional" />
                    <span class="patients-error" asp-validation-for="NewPatient.Address"></span>
                </div>

                <div class="patients-field">
                    <label class="patients-label" asp-for="NewPatient.Allergies"></label>
                    <textarea class="patients-textarea" asp-for="NewPatient.Allergies" rows="2" placeholder="Optional - e.g., Penicillin, Peanuts"></textarea>
                    <span class="patients-error" asp-validation-for="NewPatient.Allergies"></span>
                </div>

                <div class="patients-field">
                    <label class="patients-label" asp-for="NewPatient.ChronicDiseases"></label>
                    <textarea class="patients-textarea" asp-for="NewPatient.ChronicDiseases" rows="2" placeholder="Optional - e.g., Diabetes, Hypertension"></textarea>
                    <span class="patients-error" asp-validation-for="NewPatient.ChronicDiseases"></span>
                </div>

                <div class="patients-field">
                    <label class="patients-label" asp-for="NewPatient.MedicalNotes"></label>
                    <textarea class="patients-textarea" asp-for="NewPatient.MedicalNotes" rows="2" placeholder="Optional - Additional medical notes"></textarea>
                    <span class="patients-error" asp-validation-for="NewPatient.MedicalNotes"></span>
                </div>

                <div class="patients-form-actions">
                    <button type="submit" class="btn-primary">
                        Save
                    </button>
                    <button type="reset" class="btn-ghost">
                        Reset
                    </button>
                </div>
            </form>
        </div>

    </section>

    <!-- Edit Modal -->
    <div id="editModal" class="modal-overlay hidden" onclick="closeModalOnOverlay(event)">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div class="modal-header">
                <h3 class="modal-title">Edit Patient</h3>
                <button class="modal-close" onclick="closeEditModal()">&times;</button>
            </div>
            
            <form id="editForm" asp-action="Edit" asp-controller="Patients" method="post" class="modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit-id" name="id" />
                
                <div class="patients-field">
                    <label class="patients-label">ID Number</label>
                    <input class="patients-input" id="edit-idNumber" name="idNumber" />
                </div>

                <div class="patients-field-row">
                    <div class="patients-field">
                        <label class="patients-label">First Name</label>
                        <input class="patients-input" id="edit-firstName" name="firstName" required />
                    </div>
                    
                    <div class="patients-field">
                        <label class="patients-label">Last Name</label>
                        <input class="patients-input" id="edit-lastName" name="lastName" required />
                    </div>
                </div>
                
                <div class="patients-field-row">
                    <div class="patients-field">
                        <label class="patients-label">Phone</label>
                        <input class="patients-input" id="edit-phone" name="phone" type="tel" required />
                    </div>
                    
                    <div class="patients-field">
                        <label class="patients-label">Email</label>
                        <input class="patients-input" id="edit-email" name="email" type="email" />
                    </div>
                </div>
                
                <div class="patients-field-row">
                    <div class="patients-field">
                        <label class="patients-label">Date of Birth</label>
                        <input class="patients-input" id="edit-dateOfBirth" name="dateOfBirth" type="date" required />
                    </div>
                    
                    <div class="patients-field">
                        <label class="patients-label">Gender</label>
                        <select class="patients-select" id="edit-gender" name="gender" required>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                </div>
                
                <div class="patients-field">
                    <label class="patients-label">Address</label>
                    <input class="patients-input" id="edit-address" name="address" />
                </div>
                
                <div class="patients-field">
                    <label class="patients-label">Allergies</label>
                    <textarea class="patients-textarea" id="edit-allergies" name="allergies" rows="2"></textarea>
                </div>
                
                <div class="patients-field">
                    <label class="patients-label">Chronic Diseases</label>
                    <textarea class="patients-textarea" id="edit-chronicDiseases" name="chronicDiseases" rows="2"></textarea>
                </div>
                
                <div class="patients-field">
                    <label class="patients-label">Medical Notes</label>
                    <textarea class="patients-textarea" id="edit-medicalNotes" name="medicalNotes" rows="2"></textarea>
                </div>
                
                <div class="patients-form-actions">
                    <button type="submit" class="btn-primary">
                        Update
                    </button>
                    <button type="button" class="btn-ghost" onclick="closeEditModal()">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Store patients data
        const patientsData = @Html.Raw(Json.Serialize(Model.Patients.Select(p => new {
            id = p.Id,
            idNumber = p.IdNumber,
            firstName = p.FirstName,
            lastName = p.LastName,
            phone = p.Phone,
            email = p.Email,
            dateOfBirth = p.DateOfBirth.ToString("yyyy-MM-dd"),
            gender = p.Gender,
            address = p.Address,
            allergies = p.Allergies,
            chronicDiseases = p.ChronicDiseases,
            medicalNotes = p.MedicalNotes
        })));

        // Search function
        function searchPatients() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('.patient-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(input)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('patientCount').textContent = visibleCount;
        }

        // Edit patient
        function editPatient(id) {
            const patient = patientsData.find(p => p.id === id);
            if (!patient) return;
            
            // Fill modal fields
            document.getElementById('edit-id').value = patient.id;
            document.getElementById('edit-idNumber').value = patient.idNumber || '';
            document.getElementById('edit-firstName').value = patient.firstName;
            document.getElementById('edit-lastName').value = patient.lastName;
            document.getElementById('edit-phone').value = patient.phone;
            document.getElementById('edit-email').value = patient.email || '';
            document.getElementById('edit-dateOfBirth').value = patient.dateOfBirth;
            document.getElementById('edit-gender').value = patient.gender;
            document.getElementById('edit-address').value = patient.address || '';
            document.getElementById('edit-allergies').value = patient.allergies || '';
            document.getElementById('edit-chronicDiseases').value = patient.chronicDiseases || '';
            document.getElementById('edit-medicalNotes').value = patient.medicalNotes || '';
            
            // Show modal
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        function closeModalOnOverlay(event) {
            if (event.target === event.currentTarget) {
                closeEditModal();
            }
        }

        // Close modal on ESC key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeEditModal();
            }
        });
    </script>
}