@using ClinicApp.Web.Models
@model ClinicApp.Web.ViewModels.ManagerDashboardViewModel

@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Dashboard";

    // ── Trend helpers ───────────────────────────────────────────────────────
    string Trend(int current, int prev) => current > prev ? "↑" : current < prev ? "↓" : "→";
    string TrendClass(int current, int prev) => current > prev ? "trend-up" : current < prev ? "trend-dn" : "trend-eq";
    int PctChange(int current, int prev) => prev == 0 ? 0 : (int)Math.Round((current - prev) * 100.0 / prev);

    string TrendDec(decimal current, decimal prev) => current > prev ? "↑" : current < prev ? "↓" : "→";
    string TrendClassDec(decimal current, decimal prev) => current > prev ? "trend-up" : current < prev ? "trend-dn" : "trend-eq";
    int PctChangeDec(decimal current, decimal prev) => prev == 0 ? 0 : (int)Math.Round((double)((current - prev) * 100m / prev));

    // ── Sparkline scale ─────────────────────────────────────────────────────
    int sparkMax = Model.Last7DayCounts.Any() ? Math.Max(Model.Last7DayCounts.Max(), 1) : 1;
    string[] dayLabels = { "Mon","Tue","Wed","Thu","Fri","Sat","Sun" };
    // Map index 0..6 to day-of-week labels
    var today = DateTime.UtcNow.Date;
    string DayLabel(int offset) {
        var d = today.AddDays(-(6 - offset));
        return d.ToString("ddd");
    }

    // ── Today breakdown total for bar widths ────────────────────────────────
    int todayTotal = Model.TodayAppointmentsCount == 0 ? 1 : Model.TodayAppointmentsCount;
    int BreakdownPct(int n) => (int)Math.Round(n * 100.0 / todayTotal);
}

<div class="db-page">

    <!-- ═══════════════════════════ HEADING ═══════════════════════════════ -->
    <div class="db-heading">
        <div>
            <h1 class="db-heading-title">Welcome back, @Model.ManagerName</h1>
            <p class="db-heading-sub">
                @Model.ClinicName &mdash; @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
            </p>
        </div>
        <div class="db-heading-meta">
            <span class="db-pill db-pill-blue">
                Week: @Model.ThisWeekAppointments appts
            </span>
        </div>
    </div>

    <!-- ═══════════════════════════ ROW 1 — 4 PRIMARY KPI CARDS ═══════════ -->
    <div class="kpi-row">

        <!-- 1. Today's Appointments -->
        <div class="kpi-card kpi-blue">
            <div class="kpi-body">
                <div class="kpi-label">Today's Appointments</div>
                <div class="kpi-value">@Model.TodayAppointmentsCount</div>
                <div class="kpi-trend @TrendClass(Model.TodayAppointmentsCount, Model.YesterdayAppointments)">
                    @Trend(Model.TodayAppointmentsCount, Model.YesterdayAppointments)
                    @{
                        int vsDiff = Model.TodayAppointmentsCount - Model.YesterdayAppointments;
                        string vsSign = vsDiff >= 0 ? "+" : "";
                    }
                    @(vsSign)@(vsDiff) vs yesterday
                </div>
            </div>
        </div>

        <!-- 2. This Month Appointments -->
        <div class="kpi-card kpi-indigo">
            <div class="kpi-body">
                <div class="kpi-label">This Month Appts</div>
                <div class="kpi-value">@Model.ThisMonthAppointments</div>
                <div class="kpi-trend @TrendClass(Model.ThisMonthAppointments, Model.LastMonthAppointments)">
                    @Trend(Model.ThisMonthAppointments, Model.LastMonthAppointments)
                    @{int mp = PctChange(Model.ThisMonthAppointments, Model.LastMonthAppointments); string ms = mp >= 0 ? "+" : "";}
                    @(ms)@(mp)% vs last month
                </div>
            </div>
        </div>

        <!-- 3. Monthly Revenue -->
        <div class="kpi-card kpi-green">
            <div class="kpi-body">
                <div class="kpi-label">Revenue This Month</div>
                <div class="kpi-value">$@Model.RevenueThisMonth.ToString("N0")</div>
                <div class="kpi-trend @TrendClassDec(Model.RevenueThisMonth, Model.RevenueLastMonth)">
                    @TrendDec(Model.RevenueThisMonth, Model.RevenueLastMonth)
                    @{int rp = PctChangeDec(Model.RevenueThisMonth, Model.RevenueLastMonth); string rs = rp >= 0 ? "+" : "";}
                    @(rs)@(rp)% vs last month
                </div>
            </div>
        </div>

        <!-- 4. Pending Payments -->
        <div class="kpi-card kpi-amber">
            <div class="kpi-body">
                <div class="kpi-label">Pending Payments</div>
                <div class="kpi-value kpi-value-amber">$@Model.PendingPaymentsTotal.ToString("N0")</div>
                <div class="kpi-trend trend-eq">Outstanding balance</div>
            </div>
        </div>

    </div>

    <!-- ═══════════════════════════ ROW 2 — 4 SECONDARY KPI CARDS ═════════ -->
    <div class="kpi-row">

        <!-- 5. Total Patients -->
        <div class="kpi-card kpi-teal">
            <div class="kpi-body">
                <div class="kpi-label">Total Patients</div>
                <div class="kpi-value">@Model.TotalPatients</div>
                <div class="kpi-trend @TrendClass(Model.NewPatientsThisMonth, Model.NewPatientsLastMonth)">
                    @Trend(Model.NewPatientsThisMonth, Model.NewPatientsLastMonth)
                    +@Model.NewPatientsThisMonth new this month
                </div>
            </div>
        </div>

        <!-- 6. Treatments -->
        <div class="kpi-card kpi-purple">
            <div class="kpi-body">
                <div class="kpi-label">Treatments This Month</div>
                <div class="kpi-value">@Model.TreatmentsThisMonth</div>
                <div class="kpi-trend @TrendClass(Model.TreatmentsThisMonth, Model.TreatmentsLastMonth)">
                    @Trend(Model.TreatmentsThisMonth, Model.TreatmentsLastMonth)
                    @{int tp = PctChange(Model.TreatmentsThisMonth, Model.TreatmentsLastMonth); string ts = tp >= 0 ? "+" : "";}
                    @(ts)@(tp)% vs last month
                </div>
            </div>
        </div>

        <!-- 7. Active Doctors -->
        <div class="kpi-card kpi-sky">
            <div class="kpi-body">
                <div class="kpi-label">Active Doctors</div>
                <div class="kpi-value">@Model.TotalDoctors</div>
                <div class="kpi-trend trend-eq">On staff</div>
            </div>
        </div>

        <!-- 8. Low Stock Items -->
        <div class="kpi-card @(Model.LowStockMaterialsCount > 0 ? "kpi-red" : "kpi-teal")">
            <div class="kpi-body">
                <div class="kpi-label">Low Stock Items</div>
                <div class="kpi-value @(Model.LowStockMaterialsCount > 0 ? "kpi-value-red" : "")">@Model.LowStockMaterialsCount</div>
                <div class="kpi-trend @(Model.LowStockMaterialsCount > 0 ? "trend-dn" : "trend-up")">
                    @(Model.LowStockMaterialsCount > 0 ? "Action required" : "All stocked")
                </div>
            </div>
        </div>

    </div>

    <!-- ═══════════════════════════ ROW 3 — SPARKLINE CHART ═══════════════ -->
    <div class="db-card chart-card">
        <div class="db-card-head">
            <div>
                <h2 class="db-card-title">Last 7 Days — Appointments</h2>
                <p class="db-card-caption">Daily appointment volume</p>
            </div>
        </div>
        <div class="spark-wrap">
            @for (int i = 0; i < Model.Last7DayCounts.Count; i++)
            {
                int cnt = Model.Last7DayCounts[i];
                int pct = sparkMax == 0 ? 0 : (int)Math.Max(cnt * 100 / sparkMax, cnt > 0 ? 4 : 0);
                <div class="spark-col">
                    <div class="spark-count">@cnt</div>
                    <div class="spark-bar-wrap">
                        <div class="spark-bar" style="height:@(pct)%"></div>
                    </div>
                    <div class="spark-label">@DayLabel(i)</div>
                </div>
            }
        </div>
    </div>

    <!-- ═══════════════════════════ ROW 4 — SCHEDULE + SIDEBAR ═══════════ -->
    <div class="content-grid">

        <!-- LEFT: Today's Schedule -->
        <div class="db-card schedule-card">
            <div class="db-card-head">
                <div>
                    <h2 class="db-card-title">Today's Schedule</h2>
                    <p class="db-card-caption">@Model.TodayAppointmentsCount appointment(s) today</p>
                </div>
                <a class="db-link-btn" asp-controller="Appointments" asp-action="Index">View all</a>
            </div>

            @if (Model.TodayAppointments.Any())
            {
                <div class="schedule-table-wrap">
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Status</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var apt in Model.TodayAppointments)
                            {
                                var statusCls = apt.Status switch
                                {
                                    AppointmentStatus.Completed => "badge-green",
                                    AppointmentStatus.Cancelled => "badge-red",
                                    AppointmentStatus.NoShow    => "badge-gray",
                                    _                           => "badge-yellow"
                                };
                                var statusLabel = apt.Status switch
                                {
                                    AppointmentStatus.Scheduled => "Scheduled",
                                    AppointmentStatus.Completed => "Completed",
                                    AppointmentStatus.Cancelled => "Cancelled",
                                    AppointmentStatus.NoShow    => "No-Show",
                                    _                           => apt.Status.ToString()
                                };
                                int mins = (int)(apt.EndTime - apt.StartTime).TotalMinutes;
                                <tr>
                                    <td class="sched-time">@apt.StartTime.ToString("HH:mm")</td>
                                    <td>
                                        <div class="sched-patient">
                                            <div class="db-avatar db-avatar-teal sched-av">@(apt.Patient.FirstName[0])@(apt.Patient.LastName[0])</div>
                                            <span>@apt.Patient.FirstName @apt.Patient.LastName</span>
                                        </div>
                                    </td>
                                    <td class="sched-doctor">Dr. @apt.Doctor.FirstName @apt.Doctor.LastName</td>
                                    <td><span class="db-badge @statusCls">@statusLabel</span></td>
                                    <td class="sched-dur">@mins min</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="db-empty">
                    <p>No appointments scheduled for today</p>
                </div>
            }
        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="sidebar-col">

            <!-- Top Doctors This Month -->
            <div class="db-card">
                <div class="db-card-head">
                    <div>
                        <h2 class="db-card-title">Top Doctors This Month</h2>
                        <p class="db-card-caption">By appointment count</p>
                    </div>
                </div>
                @if (Model.TopDoctors.Any())
                {
                    <div class="doctor-list">
                        @for (int i = 0; i < Model.TopDoctors.Count; i++)
                        {
                            var doc = Model.TopDoctors[i];
                            <div class="doctor-row">
                                <div class="doctor-rank">#@(i + 1)</div>
                                <div class="doctor-info">
                                    <div class="doctor-name">@doc.Name</div>
                                    <div class="doctor-meta">
                                        <span class="dmeta-item dmeta-blue">@doc.AppointmentsThisMonth appts</span>
                                        <span class="dmeta-item dmeta-purple">@doc.TreatmentsThisMonth treats</span>
                                        <span class="dmeta-item dmeta-teal">@doc.HoursThisMonth h</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="db-empty">No appointment data for this month</div>
                }
            </div>

            <!-- Recent Patients -->
            <div class="db-card">
                <div class="db-card-head">
                    <div>
                        <h2 class="db-card-title">Recent Patients</h2>
                        <p class="db-card-caption">Last registered</p>
                    </div>
                    <a class="db-link-btn" asp-controller="Patients" asp-action="Index">View all</a>
                </div>
                @if (Model.RecentPatients.Any())
                {
                    <div class="db-list">
                        @foreach (var p in Model.RecentPatients)
                        {
                            <div class="db-list-row">
                                <div class="db-avatar db-avatar-blue">@(p.FirstName[0])@(p.LastName[0])</div>
                                <div class="db-list-info">
                                    <span class="db-list-primary">@p.FirstName @p.LastName</span>
                                    <span class="db-list-secondary">@p.Phone</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="db-empty">No patients registered yet</div>
                }
            </div>

        </div>
    </div>

    <!-- ═══════════════════════════ ROW 5 — LOW STOCK + BREAKDOWN ════════ -->
    <div class="content-grid">

        <!-- LEFT: Low Stock Alert -->
        <div class="db-card">
            <div class="db-card-head">
                <div>
                    <h2 class="db-card-title">Low Stock Alert</h2>
                    <p class="db-card-caption">Materials running low</p>
                </div>
                <a class="db-link-btn" asp-controller="Materials" asp-action="Index">View all</a>
            </div>
            @if (Model.LowStockMaterials.Any())
            {
                <div class="stock-list">
                    @foreach (var m in Model.LowStockMaterials)
                    {
                        int stockPct = m.MinimumLimit == 0 ? 0 : Math.Min((int)(m.Quantity * 100.0 / m.MinimumLimit), 100);
                        string barColor = stockPct <= 25 ? "stock-bar-red" : stockPct <= 75 ? "stock-bar-amber" : "stock-bar-green";
                        <div class="stock-row">
                            <div class="stock-row-top">
                                <div class="stock-name">@m.Name</div>
                                <div class="stock-qty"><span class="stock-num">@m.Quantity</span> / @m.MinimumLimit @m.Unit</div>
                            </div>
                            <div class="stock-bar-bg">
                                <div class="stock-bar @barColor" style="width:@(stockPct)%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="db-empty">
                    <p>All materials are fully stocked</p>
                </div>
            }
        </div>

        <!-- RIGHT: Today's Breakdown -->
        <div class="db-card">
            <div class="db-card-head">
                <div>
                    <h2 class="db-card-title">Appointment Breakdown Today</h2>
                    <p class="db-card-caption">Status distribution</p>
                </div>
            </div>
            <div class="breakdown-list">

                <div class="breakdown-row">
                    <div class="breakdown-label">
                        <span class="breakdown-dot bd-yellow"></span>
                        Scheduled
                    </div>
                    <div class="breakdown-bar-wrap">
                        <div class="breakdown-bar bd-bar-yellow" style="width:@(BreakdownPct(Model.TodayScheduled))%"></div>
                    </div>
                    <div class="breakdown-count">@Model.TodayScheduled</div>
                </div>

                <div class="breakdown-row">
                    <div class="breakdown-label">
                        <span class="breakdown-dot bd-green"></span>
                        Completed
                    </div>
                    <div class="breakdown-bar-wrap">
                        <div class="breakdown-bar bd-bar-green" style="width:@(BreakdownPct(Model.TodayCompleted))%"></div>
                    </div>
                    <div class="breakdown-count">@Model.TodayCompleted</div>
                </div>

                <div class="breakdown-row">
                    <div class="breakdown-label">
                        <span class="breakdown-dot bd-red"></span>
                        Cancelled
                    </div>
                    <div class="breakdown-bar-wrap">
                        <div class="breakdown-bar bd-bar-red" style="width:@(BreakdownPct(Model.TodayCancelled))%"></div>
                    </div>
                    <div class="breakdown-count">@Model.TodayCancelled</div>
                </div>

                <div class="breakdown-row">
                    <div class="breakdown-label">
                        <span class="breakdown-dot bd-gray"></span>
                        No-Show
                    </div>
                    <div class="breakdown-bar-wrap">
                        <div class="breakdown-bar bd-bar-gray" style="width:@(BreakdownPct(Model.TodayNoShow))%"></div>
                    </div>
                    <div class="breakdown-count">@Model.TodayNoShow</div>
                </div>

                @if (Model.TodayAppointmentsCount == 0)
                {
                    <p class="breakdown-empty">No appointments today</p>
                }
            </div>
        </div>

    </div>

</div>

<style>
/* ═══════════════════════════ BASE ═══════════════════════════════════════ */
.db-page { display: flex; flex-direction: column; gap: 20px; }

/* ── Heading ──────────────────────────────────────────────────────────── */
.db-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.db-heading-title { font-size: 22px; font-weight: 700; color: var(--color-text); }
.db-heading-sub   { font-size: 13px; color: var(--color-text-muted); margin-top: 2px; }
.db-heading-meta  { display: flex; gap: 8px; flex-wrap: wrap; }
.db-pill { display: inline-flex; align-items: center; padding: 4px 12px; border-radius: 4px; font-size: 12px; font-weight: 500; }
.db-pill-blue { color: var(--color-text-muted); border: 1px solid var(--color-border); background: transparent; }

/* ── KPI Row ──────────────────────────────────────────────────────────── */
.kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

.kpi-card {
    position: relative;
    background: var(--color-surface);
    border-radius: 10px;
    padding: 18px 20px 16px;
    display: flex; align-items: flex-start;
    border: 1px solid var(--color-border);
}
.kpi-card::before {
    content: "";
    position: absolute;
    left: 0; top: 14px; bottom: 14px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: #1c5c44;
}

.kpi-body { flex: 1; min-width: 0; }
.kpi-label { font-size: 11px; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 4px; }
.kpi-value { font-size: 28px; font-weight: 700; color: var(--color-text); line-height: 1.1; }
.kpi-value-amber { color: var(--color-text); }
.kpi-value-red   { color: #dc2626; }

.kpi-trend { font-size: 12px; margin-top: 5px; font-weight: 500; }
.trend-up { color: #1c5c44; }
.trend-dn { color: #dc2626; }
.trend-eq { color: #6b7280; }

/* ── Common Card ──────────────────────────────────────────────────────── */
.db-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 18px 20px;
}
.db-card-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
.db-card-title { font-size: 14px; font-weight: 600; color: var(--color-text); }
.db-card-caption { font-size: 12px; color: var(--color-text-muted); margin-top: 2px; }
.db-link-btn { font-size: 12px; color: var(--color-sky); text-decoration: none; white-space: nowrap; font-weight: 500; }
.db-link-btn:hover { text-decoration: underline; }

/* ── Sparkline / Bar Chart ────────────────────────────────────────────── */
.spark-wrap {
    display: flex; align-items: flex-end; gap: 10px;
    height: 120px; padding-top: 28px;
}
.spark-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0; }
.spark-count { font-size: 11px; font-weight: 700; color: var(--color-text-muted); margin-bottom: 4px; min-height: 16px; }
.spark-bar-wrap { flex: 1; width: 100%; display: flex; align-items: flex-end; }
.spark-bar { width: 100%; border-radius: 3px 3px 0 0; background: #1c5c44; min-height: 3px; transition: height .3s; opacity: 0.75; }
.spark-label { font-size: 11px; color: var(--color-text-muted); margin-top: 6px; font-weight: 500; }

/* ── Content Grid ─────────────────────────────────────────────────────── */
.content-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 16px; align-items: start; }
.sidebar-col { display: flex; flex-direction: column; gap: 16px; }

/* ── Schedule Table ───────────────────────────────────────────────────── */
.schedule-table-wrap { overflow-x: auto; }
.schedule-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.schedule-table th {
    text-align: left; padding: 8px 10px;
    font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .4px;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
}
.schedule-table td {
    padding: 10px 10px;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
}
.schedule-table tbody tr:last-child td { border-bottom: none; }
.schedule-table tbody tr:hover td { background: var(--color-surface-alt); }
.sched-time   { font-weight: 600; color: var(--color-text); white-space: nowrap; }
.sched-patient { display: flex; align-items: center; gap: 8px; }
.sched-doctor  { color: var(--color-text-muted); font-size: 12px; }
.sched-dur     { color: var(--color-text-muted); font-size: 12px; white-space: nowrap; }
.sched-av { width: 28px; height: 28px; font-size: 11px; flex-shrink: 0; border-radius: 6px; }

/* ── Doctor List ──────────────────────────────────────────────────────── */
.doctor-list { display: flex; flex-direction: column; gap: 10px; }
.doctor-row { display: flex; align-items: flex-start; gap: 12px; padding: 10px 12px; border-radius: 8px; background: var(--color-surface-alt); border: 1px solid var(--color-border); }
.doctor-rank { width: 24px; height: 24px; border-radius: 4px; background: transparent; border: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
.doctor-info { flex: 1; min-width: 0; }
.doctor-name { font-size: 13px; font-weight: 600; color: var(--color-text); }
.doctor-meta { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 4px; }
.dmeta-item { font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 500; color: var(--color-text-muted); border: 1px solid var(--color-border); background: transparent; }

/* ── List / Avatar ────────────────────────────────────────────────────── */
.db-list { display: flex; flex-direction: column; gap: 8px; }
.db-list-row {
    display: flex; align-items: center; gap: 12px;
    padding: 9px 12px; border-radius: 8px;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
}
.db-list-info { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.db-list-primary { font-size: 13px; font-weight: 500; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.db-list-secondary { font-size: 12px; color: var(--color-text-muted); }

.db-avatar { width: 34px; height: 34px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; color: #fff; background: #1c5c44; }
.db-avatar-teal   { background: #1c5c44; }
.db-avatar-blue   { background: #1c5c44; }
.db-avatar-purple { background: #1c5c44; }

/* ── Badges ───────────────────────────────────────────────────────────── */
.db-badge { padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; white-space: nowrap; }
.badge-yellow { color: #92400e; border: 1px solid #fde68a; background: transparent; }
.badge-green  { color: #1c5c44; border: 1px solid #a7f3d0; background: transparent; }
.badge-red    { color: #b91c1c; border: 1px solid #fecaca; background: transparent; }
.badge-gray   { color: #6b7280; border: 1px solid #d1d5db; background: transparent; }

/* ── Low Stock ────────────────────────────────────────────────────────── */
.stock-list { display: flex; flex-direction: column; gap: 12px; }
