@model ClinicApp.Web.ViewModels.DoctorSchedulePageViewModel

@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Doctor Schedules";
}

<link rel="stylesheet" href="~/css/manager.css" />

<div style="padding: 0;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 22px; font-weight: 700; color: #1e293b; margin: 0;">Doctor Working Hours</h1>
            <p style="color: #64748b; font-size: 14px; margin: 4px 0 0;">Set which days and hours each doctor works. Only available doctors will appear when booking appointments.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin-bottom: 20px;">@TempData["Success"]</div>
    }

    @if (!Model.Doctors.Any())
    {
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 48px; text-align: center; color: #64748b;">
            No doctors found in this clinic. Add doctors first from the Users section.
        </div>
    }
    else
    {
        <form asp-action="SaveDoctorSchedules" method="post" id="scheduleForm">
            @Html.AntiForgeryToken()

            @for (int di = 0; di < Model.Doctors.Count; di++)
            {
                var doctor = Model.Doctors[di];
                <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; margin-bottom: 24px; overflow: hidden;">
                    <div style="background: #f1f5f9; padding: 16px 20px; border-bottom: 1px solid #e2e8f0;">
                        <h3 style="margin: 0; font-size: 16px; font-weight: 600; color: #1e293b;">@doctor.DoctorName</h3>
                    </div>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <thead>
                                <tr style="background: #f8fafc;">
                                    <th style="padding: 10px 16px; text-align: left; color: #64748b; font-weight: 600; width: 130px;">Day</th>
                                    <th style="padding: 10px 16px; text-align: center; color: #64748b; font-weight: 600; width: 100px;">Working?</th>
                                    <th style="padding: 10px 16px; text-align: left; color: #64748b; font-weight: 600;">Start Time</th>
                                    <th style="padding: 10px 16px; text-align: left; color: #64748b; font-weight: 600;">End Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int si = 0; si < doctor.Schedule.Count; si++)
                                {
                                    var day = doctor.Schedule[si];
                                    var prefix = $"schedules[{di * 7 + si}]";
                                    <tr style="border-top: 1px solid #f1f5f9;" class="schedule-row @(day.IsWorkingDay ? "working" : "off")">
                                        <td style="padding: 12px 16px; font-weight: 500; color: #374151;">
                                            @day.DayName
                                            <input type="hidden" name="@(prefix).DoctorId" value="@day.DoctorId" />
                                            <input type="hidden" name="@(prefix).DayOfWeek" value="@((int)day.DayOfWeek)" />
                                            @if (day.Id.HasValue)
                                            {
                                                <input type="hidden" name="@(prefix).Id" value="@day.Id" />
                                            }
                                        </td>
                                        <td style="padding: 12px 16px; text-align: center;">
                                            <label style="display: inline-flex; align-items: center; cursor: pointer; gap: 6px;">
                                                <input type="checkbox"
                                                       name="@(prefix).IsWorkingDay"
                                                       value="true"
                                                       @(day.IsWorkingDay ? "checked" : "")
                                                       class="working-checkbox"
                                                       style="width: 16px; height: 16px; cursor: pointer;" />
                                            </label>
                                        </td>
                                        <td style="padding: 12px 16px;">
                                            <input type="time"
                                                   name="@(prefix).StartTime"
                                                   value="@day.StartTime"
                                                   class="time-input"
                                                   style="border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 10px; font-size: 14px; color: #374151; @(day.IsWorkingDay ? "" : "opacity:0.4")" />
                                        </td>
                                        <td style="padding: 12px 16px;">
                                            <input type="time"
                                                   name="@(prefix).EndTime"
                                                   value="@day.EndTime"
                                                   class="time-input"
                                                   style="border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 10px; font-size: 14px; color: #374151; @(day.IsWorkingDay ? "" : "opacity:0.4")" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div style="display: flex; justify-content: flex-end; margin-top: 8px;">
                <button type="submit" class="btn-primary" style="padding: 10px 28px; font-size: 15px;">Save All Schedules</button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.working-checkbox').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var row = this.closest('tr');
                var inputs = row.querySelectorAll('.time-input');
                inputs.forEach(function (input) {
                    input.style.opacity = checkbox.checked ? '1' : '0.4';
                });
            });
        });
    </script>
}
