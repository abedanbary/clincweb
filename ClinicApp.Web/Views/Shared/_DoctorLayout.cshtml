@{
    Layout = null;
    var title = ViewData["Title"] ?? "Doctor Panel";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@title - Clinic Doctor</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/css/manager.css" />
    <link rel="stylesheet" href="~/css/doctor-dashboard.css" />
    <link rel="stylesheet" href="~/css/patients.css" />
    <link rel="stylesheet" href="~/css/payments.css" />
    <link rel="stylesheet" href="~/css/materials.css" />
    <link rel="stylesheet" href="~/css/attendance.css" />
    <link rel="stylesheet" href="~/css/rtl.css" />
</head>


<body>
    <div class="manager-shell">
        <!-- Sidebar -->
        <aside class="manager-sidebar">
            <div class="sidebar-header">
                <div class="brand-logo">
                    Dr
                </div>
                <div class="brand-text">
                    <span class="brand-title">Clinic Doctor</span>
                    <span class="brand-subtitle">Doctor Portal</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-section">
                    <div class="sidebar-section-title">Overview</div>
                    <a class="sidebar-link" asp-controller="Doctor" asp-action="Index">
                        <span class="sidebar-link-text">Dashboard</span>
                    </a>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-title">Patient Care</div>
                    <a class="sidebar-link" asp-controller="Patients" asp-action="Index">
                        <span class="sidebar-link-text">Patients</span>
                    </a>
                    <a class="sidebar-link" asp-controller="Appointments" asp-action="Index">
                        <span class="sidebar-link-text">Appointments</span>
                    </a>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-title">Finance</div>
                    <a class="sidebar-link" asp-controller="Payments" asp-action="Index">
                        <span class="sidebar-link-text">Payments</span>
                    </a>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-title">My Work</div>
                    <a class="sidebar-link" asp-controller="Attendance" asp-action="MyAttendance">
                        <span class="sidebar-link-text">Attendance</span>
                    </a>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-title">Resources</div>
                    <a class="sidebar-link" asp-controller="Materials" asp-action="Index">
                        <span class="sidebar-link-text">Materials</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main area -->
        <div class="manager-main">
            <!-- Top bar -->
            <header class="manager-topbar">
                <div class="topbar-left">
                    <span class="topbar-page-title">@title</span>
                </div>

                <div class="topbar-right">
                    <div class="topbar-user">
                        <div class="user-avatar">
                            @(User.FindFirst("FirstName")?.Value?[0] ?? 'D')
                        </div>
                        <div class="user-info">
                            <span class="user-name">
                                Dr. @User.FindFirst("FirstName")?.Value @User.FindFirst("LastName")?.Value
                            </span>
                            <span class="user-role">Doctor</span>
                        </div>
                    </div>

                    <select class="lang-select" onchange="setLanguage(this.value)" style="border:1px solid rgba(0,0,0,0.15);background:#fff;color:var(--color-text);padding:4px 8px;border-radius:6px;font-size:13px;cursor:pointer;outline:none;">
                        <option value="en">English</option>
                        <option value="he">עברית</option>
                        <option value="ar">العربية</option>
                    </select>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display: inline;">
                        <button type="submit" class="topbar-button">
                            Logout
                        </button>
                    </form>
                </div>
            </header>

            <!-- Content -->
            <main class="manager-content">
                @RenderBody()
            </main>

           
        </div>
    </div>
    <script src="~/js/simple-image-viewer.js"></script>
    <script src="~/js/i18n.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>