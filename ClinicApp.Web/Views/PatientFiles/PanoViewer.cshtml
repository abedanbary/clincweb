@using ClinicApp.Web.ViewModels
@using ClinicApp.Web.Services.Storage
@model PatientFileViewerViewModel

@{
    Layout = null;
    var streamUrl = $"/patients/{Model.PatientId}/files/{Model.FileId}/stream";
    var backUrl = $"/patients/{Model.PatientId}/files";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panoramic Viewer — @Model.OriginalFileName</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Defines the --dt-* tokens this page's styles reference. -->
    <link rel="stylesheet" href="~/css/dentaltrack.css" asp-append-version="true" />
    <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; font-family: system-ui, -apple-system, sans-serif; background: var(--dt-surface-alt); }

    .viewer-shell { display: flex; height: 100vh; }

    /* ── Side panel ── */
    .viewer-panel {
        width: 290px; flex-shrink: 0;
        background: #ffffff; border-right: 1px solid var(--dt-border);
        display: flex; flex-direction: column;
        padding: 1.25rem; gap: 1rem; overflow-y: auto;
        color: var(--dt-ink);
    }

    .panel-back {
        display: inline-flex; align-items: center; gap: .4rem;
        color: var(--dt-success); text-decoration: none; font-size: .83rem; font-weight: 500;
        background: var(--dt-success-bg); padding: .45rem .8rem;
        border-radius: 8px; border: 1px solid var(--dt-success-line);
        transition: background .15s;
    }
    .panel-back:hover { background: var(--dt-success-line); }

    .panel-title { font-size: .93rem; font-weight: 600; color: var(--dt-ink); word-break: break-all; line-height: 1.4; }
    .panel-badge {
        display: inline-block; margin-top: .35rem;
        padding: .2rem .65rem; border-radius: 999px;
        font-size: .7rem; font-weight: 600; letter-spacing: .02em;
        background: var(--dt-warning-bg); color: var(--dt-warning); border: 1px solid var(--dt-warning-line);
    }

    .panel-divider { height: 1px; background: var(--dt-border); flex-shrink: 0; }

    .panel-meta { display: flex; flex-direction: column; gap: .45rem; }
    .meta-row { display: flex; justify-content: space-between; align-items: baseline; font-size: .8rem; gap: .5rem; }
    .meta-label { color: var(--dt-text-muted); white-space: nowrap; }
    .meta-value { color: var(--dt-ink); font-weight: 500; text-align: right; }

    .panel-notes {
        font-size: .8rem; color: var(--dt-text-muted); background: var(--dt-surface-alt);
        border-radius: 8px; padding: .65rem; border: 1px solid var(--dt-border); line-height: 1.5;
    }

    /* ── Controls ── */
    .ctrl-section-label {
        font-size: .72rem; font-weight: 600; color: var(--dt-text-muted);
        text-transform: uppercase; letter-spacing: .06em; margin-bottom: .5rem;
    }

    .ctrl-slider-row { display: flex; flex-direction: column; gap: .25rem; margin-bottom: .6rem; }
    .ctrl-slider-header { display: flex; justify-content: space-between; font-size: .78rem; }
    .ctrl-slider-name { color: var(--dt-text-muted); font-weight: 500; }
    .ctrl-slider-val  { color: var(--dt-success); font-weight: 600; font-size: .75rem; min-width: 2.5rem; text-align: right; }
    input[type=range] {
        width: 100%; height: 4px; border-radius: 2px; cursor: pointer;
        accent-color: var(--dt-success); background: var(--dt-border);
    }

    .ctrl-btn-row { display: flex; gap: .4rem; flex-wrap: wrap; }
    .ctrl-btn {
        flex: 1; min-width: 0; padding: .38rem .4rem; border-radius: 7px;
        border: 1px solid var(--dt-border); background: var(--dt-surface-alt); color: var(--dt-text-muted);
        font-size: .75rem; font-weight: 500; cursor: pointer; text-align: center;
        transition: background .12s, border-color .12s;
        white-space: nowrap;
    }
    .ctrl-btn:hover { background: var(--dt-border); border-color: var(--dt-text-faint); }
    .ctrl-btn.active { background: var(--dt-success-bg); color: var(--dt-success); border-color: var(--dt-success-line); }

    /* ── Loupe size slider ── */
    .ctrl-slider-row input[type=range]#slLoupeSize { accent-color: var(--dt-warning); }

    /* ── Action buttons ── */
    .panel-actions { display: flex; flex-direction: column; gap: .5rem; margin-top: auto; }
    .btn-panel {
        padding: .52rem .9rem; border-radius: 8px; border: none; cursor: pointer;
        font-size: .82rem; font-weight: 500; text-align: center; text-decoration: none;
        display: block; transition: background .15s;
    }
    .btn-reset { background: var(--dt-surface-alt); color: var(--dt-text-muted); border: 1px solid var(--dt-border); }
    .btn-reset:hover { background: var(--dt-border); }
    .btn-dl    { background: var(--dt-success); color: #ffffff; border: 1px solid var(--dt-success); }
    .btn-dl:hover { background: var(--dt-success-hover); }

    /* ── Viewer area ── */
    .viewer-area {
        flex: 1; position: relative; overflow: hidden;
        background: var(--dt-ink); display: flex; align-items: center; justify-content: center;
        cursor: crosshair;
    }
    .viewer-area.panning { cursor: grabbing; }
    .viewer-area.loupe-off { cursor: grab; }
    .viewer-area.loupe-off.panning { cursor: grabbing; }

    #pano-img {
        max-width: none; max-height: none;
        transform-origin: center center;
        user-select: none; pointer-events: none;
        display: block;
    }

    /* ── Loupe magnifier ── */
    #loupe {
        position: absolute; border-radius: 50%;
        border: 2px solid rgba(16,185,129,.7);
        box-shadow: 0 0 0 1px rgba(0,0,0,.5), 0 4px 20px rgba(0,0,0,.5);
        overflow: hidden; pointer-events: none;
        display: none; z-index: 20;
        background-color: var(--dt-ink);
    }
    #loupe canvas { display: block; }

    /* Loading overlay */
    .viewer-loading {
        position: absolute; inset: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 1rem; pointer-events: none; transition: opacity .3s;
        background: var(--dt-ink); color: var(--dt-text-faint); z-index: 10;
    }
    .viewer-loading.hidden { opacity: 0; pointer-events: none; }
    .spinner {
        width: 44px; height: 44px; border: 3px solid rgba(16,185,129,.2);
        border-top-color: var(--dt-success); border-radius: 50%; animation: spin .8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .zoom-badge {
        position: absolute; top: 1rem; right: 1rem;
        background: rgba(0,0,0,.55); color: var(--dt-border); border-radius: 6px;
        padding: .3rem .6rem; font-size: .75rem; font-weight: 600;
        pointer-events: none; backdrop-filter: blur(4px);
    }
    .loupe-badge {
        position: absolute; top: 1rem; left: 1rem;
        background: rgba(245,158,11,.15); color: var(--dt-warning); border-radius: 6px;
        padding: .3rem .6rem; font-size: .72rem; font-weight: 600;
        border: 1px solid rgba(245,158,11,.3);
        pointer-events: none; backdrop-filter: blur(4px);
    }

    .controls-hint {
        position: absolute; bottom: 1rem; right: 1rem;
        background: rgba(0,0,0,.55); color: var(--dt-text-faint); border-radius: 8px;
        padding: .45rem .7rem; font-size: .7rem; line-height: 1.7;
        pointer-events: none; backdrop-filter: blur(4px);
    }
    </style>
</head>
<body>
<div class="viewer-shell">

    <!-- Side panel -->
    <aside class="viewer-panel">

        <a href="@backUrl" class="panel-back">← Back to Files</a>

        <div>
            <div class="panel-title">@Model.OriginalFileName</div>
            <span class="panel-badge">@PatientFileHelper.GetDisplayName(Model.Category)</span>
        </div>

        <div class="panel-divider"></div>

        <div class="panel-meta">
            <div class="meta-row">
                <span class="meta-label">Patient</span>
                <span class="meta-value">@Model.PatientFirstName @Model.PatientLastName</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Format</span>
                <span class="meta-value">@Model.Extension.ToUpper()</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Size</span>
                <span class="meta-value">@PatientFileHelper.GetHumanReadableFileSize(Model.Size)</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Uploaded</span>
                <span class="meta-value">@Model.UploadedAtUtc.ToString("MMM dd, yyyy")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="panel-notes">@Model.Notes</div>
        }

        <div class="panel-divider"></div>

        <!-- Image adjustments -->
        <div>
            <div class="ctrl-section-label">Image Adjustments</div>

            <div class="ctrl-slider-row">
                <div class="ctrl-slider-header">
                    <span class="ctrl-slider-name">Brightness</span>
                    <span class="ctrl-slider-val" id="valBrightness">100%</span>
                </div>
                <input type="range" id="slBrightness" min="0" max="300" value="100" step="1" oninput="applyFilters()" />
            </div>

            <div class="ctrl-slider-row">
                <div class="ctrl-slider-header">
                    <span class="ctrl-slider-name">Contrast</span>
                    <span class="ctrl-slider-val" id="valContrast">100%</span>
                </div>
                <input type="range" id="slContrast" min="0" max="400" value="100" step="1" oninput="applyFilters()" />
            </div>

            <div class="ctrl-slider-row">
                <div class="ctrl-slider-header">
                    <span class="ctrl-slider-name">Sharpness</span>
                    <span class="ctrl-slider-val" id="valSharpness">0</span>
                </div>
                <input type="range" id="slSharpness" min="0" max="10" value="0" step="0.5" oninput="applyFilters()" />
            </div>
        </div>

        <div>
            <div class="ctrl-section-label">Enhancements</div>
            <div class="ctrl-btn-row">
                <button class="ctrl-btn" id="btnInvert" onclick="toggleInvert()">Invert</button>
                <button class="ctrl-btn" id="btnFlipH" onclick="toggleFlipH()">Flip H</button>
                <button class="ctrl-btn" id="btnFlipV" onclick="toggleFlipV()">Flip V</button>
            </div>
        </div>

        <div>
            <div class="ctrl-section-label">Rotation</div>
            <div class="ctrl-btn-row">
                <button class="ctrl-btn" onclick="rotate(-90)">↺ 90°</button>
                <button class="ctrl-btn" onclick="rotate(90)">↻ 90°</button>
                <button class="ctrl-btn" onclick="rotate(180)">180°</button>
            </div>
        </div>

        <div>
            <div class="ctrl-section-label">Zoom</div>
            <div class="ctrl-btn-row">
                <button class="ctrl-btn" onclick="zoom(0.25)">+25%</button>
                <button class="ctrl-btn" onclick="zoom(-0.25)">−25%</button>
                <button class="ctrl-btn" onclick="setZoom(1)">1:1</button>
                <button class="ctrl-btn" onclick="fitToWidth()">Fit W</button>
                <button class="ctrl-btn" onclick="fitToView()">Fit</button>
            </div>
        </div>

        <!-- Loupe magnifier -->
        <div>
            <div class="ctrl-section-label">Magnifier Loupe</div>
            <div class="ctrl-btn-row" style="margin-bottom:.5rem;">
                <button class="ctrl-btn active" id="btnLoupe" onclick="toggleLoupe()">Loupe ON</button>
            </div>
            <div class="ctrl-slider-row">
                <div class="ctrl-slider-header">
                    <span class="ctrl-slider-name">Size</span>
                    <span class="ctrl-slider-val" id="valLoupeSize">180px</span>
                </div>
                <input type="range" id="slLoupeSize" min="80" max="360" value="180" step="10" oninput="updateLoupeSize()" />
            </div>
            <div class="ctrl-slider-row">
                <div class="ctrl-slider-header">
                    <span class="ctrl-slider-name">Zoom ×</span>
                    <span class="ctrl-slider-val" id="valLoupeZoom">3×</span>
                </div>
                <input type="range" id="slLoupeZoom" min="1.5" max="8" value="3" step="0.5" oninput="updateLoupeZoom()" />
            </div>
        </div>

        <div class="panel-actions">
            <button class="btn-panel btn-reset" onclick="resetAll()">Reset All</button>
            <a href="@streamUrl" download="@Model.OriginalFileName" class="btn-panel btn-dl">Download File</a>
        </div>

    </aside>

    <!-- Viewer area -->
    <div class="viewer-area" id="viewerArea">

        <div class="viewer-loading" id="loadingOverlay">
            <div class="spinner"></div>
            <span style="font-size:.85rem;">Loading panoramic image…</span>
        </div>

        <img id="pano-img" src="@streamUrl" alt="@Model.OriginalFileName"
             onload="onImageLoaded()" onerror="onImageError()" draggable="false" />

        <!-- Loupe -->
        <div id="loupe"><canvas id="loupeCanvas"></canvas></div>

        <div class="zoom-badge" id="zoomBadge">100%</div>
        <div class="loupe-badge" id="loupeBadge">🔍 Loupe ON</div>

        <div class="controls-hint">
            🔍 Hover to magnify &nbsp;|&nbsp; Hold drag to pan &nbsp;|&nbsp; Scroll to zoom
        </div>
    </div>

</div>

<script>
const img = document.getElementById('pano-img');
const area = document.getElementById('viewerArea');
const loadingOverlay = document.getElementById('loadingOverlay');
const zoomBadge = document.getElementById('zoomBadge');
const loupeBadge = document.getElementById('loupeBadge');
const loupe = document.getElementById('loupe');
const loupeCanvas = document.getElementById('loupeCanvas');
const loupeCtx = loupeCanvas.getContext('2d');

// State
let scale = 1;
let rotation = 0;
let flipH = false;
let flipV = false;
let inverted = false;
let translateX = 0;
let translateY = 0;
let loupeEnabled = true;
let loupeSize = 180;
let loupeZoom = 3;

// Pan state
let isPanning = false;
let panStart = { x: 0, y: 0 };
let mousePos = { x: 0, y: 0 };

function onImageLoaded() {
    loadingOverlay.classList.add('hidden');
    fitToWidth();
}

function onImageError() {
    loadingOverlay.classList.add('hidden');
    area.innerHTML = '<div style="color:var(--dt-danger-line);text-align:center;padding:2rem;"><div style="font-size:2rem">⚠️</div><div style="margin-top:.5rem">Failed to load image.</div><a href="@backUrl" style="color:var(--dt-success);font-size:.85rem;display:block;margin-top:.75rem;">← Back to files</a></div>';
}

function fitToWidth() {
    const aw = area.clientWidth;
    const iw = img.naturalWidth || img.width;
    if (!iw) return;
    scale = (aw / iw) * 0.96;
    translateX = 0;
    translateY = 0;
    applyTransform();
}

function fitToView() {
    const aw = area.clientWidth, ah = area.clientHeight;
    const iw = img.naturalWidth || img.width;
    const ih = img.naturalHeight || img.height;
    if (!iw || !ih) return;
    scale = Math.min(aw / iw, ah / ih) * 0.92;
    translateX = 0;
    translateY = 0;
    applyTransform();
}

function applyTransform() {
    const fh = flipH ? -1 : 1;
    const fv = flipV ? -1 : 1;
    img.style.transform =
        `translate(${translateX}px, ${translateY}px) rotate(${rotation}deg) scale(${scale * fh}, ${scale * fv})`;
    zoomBadge.textContent = Math.round(scale * 100) + '%';
}

function applyFilters() {
    const brightness = document.getElementById('slBrightness').value;
    const contrast   = document.getElementById('slContrast').value;
    const sharpness  = parseFloat(document.getElementById('slSharpness').value);

    document.getElementById('valBrightness').textContent = brightness + '%';
    document.getElementById('valContrast').textContent   = contrast + '%';
    document.getElementById('valSharpness').textContent  = sharpness;

    const invertVal = inverted ? 1 : 0;
    img.style.filter = `brightness(${brightness / 100}) contrast(${contrast / 100}) invert(${invertVal})`;
    if (sharpness > 0) {
        const px = Math.round(sharpness * 0.5);
        img.style.filter += ` drop-shadow(0 0 ${px}px rgba(255,255,255,${sharpness * 0.04}))`;
    }
}

function toggleInvert() {
    inverted = !inverted;
    document.getElementById('btnInvert').classList.toggle('active', inverted);
    applyFilters();
}

function toggleFlipH() {
    flipH = !flipH;
    document.getElementById('btnFlipH').classList.toggle('active', flipH);
    applyTransform();
}

function toggleFlipV() {
    flipV = !flipV;
    document.getElementById('btnFlipV').classList.toggle('active', flipV);
    applyTransform();
}

function rotate(deg) {
    rotation = (rotation + deg) % 360;
    applyTransform();
}

function zoom(delta) {
    scale = Math.max(0.05, Math.min(20, scale + delta));
    applyTransform();
}

function setZoom(s) {
    scale = s;
    translateX = 0;
    translateY = 0;
    applyTransform();
}

// ── Loupe ─────────────────────────────────────────────────────────────────────
function toggleLoupe() {
    loupeEnabled = !loupeEnabled;
    const btn = document.getElementById('btnLoupe');
    btn.textContent = loupeEnabled ? 'Loupe ON' : 'Loupe OFF';
    btn.classList.toggle('active', loupeEnabled);
    loupeBadge.textContent = loupeEnabled ? '🔍 Loupe ON' : '';
    loupeBadge.style.display = loupeEnabled ? '' : 'none';
    if (!loupeEnabled) loupe.style.display = 'none';
    area.classList.toggle('loupe-off', !loupeEnabled);
    updateControlsHint();
}

function updateControlsHint() {
    const hint = area.querySelector('.controls-hint');
    if (!hint) return;
    hint.textContent = loupeEnabled
        ? '🔍 Hover to magnify | Hold drag to pan | Scroll to zoom'
        : '🖱 Drag to pan | Scroll to zoom';
}

function updateLoupeSize() {
    loupeSize = parseInt(document.getElementById('slLoupeSize').value);
    document.getElementById('valLoupeSize').textContent = loupeSize + 'px';
    loupeCanvas.width  = loupeSize;
    loupeCanvas.height = loupeSize;
    loupe.style.width  = loupeSize + 'px';
    loupe.style.height = loupeSize + 'px';
    drawLoupe(mousePos.x, mousePos.y);
}

function updateLoupeZoom() {
    loupeZoom = parseFloat(document.getElementById('slLoupeZoom').value);
    document.getElementById('valLoupeZoom').textContent = loupeZoom + '×';
    drawLoupe(mousePos.x, mousePos.y);
}

function drawLoupe(cx, cy) {
    if (!loupeEnabled || !img.naturalWidth) return;

    const areaRect = area.getBoundingClientRect();

    // Image position in viewport
    const imgRect = img.getBoundingClientRect();

    // Cursor position relative to the displayed image
    const relX = cx - imgRect.left;
    const relY = cy - imgRect.top;

    // Clamp to image bounds
    if (relX < 0 || relY < 0 || relX > imgRect.width || relY > imgRect.height) {
        loupe.style.display = 'none';
        return;
    }

    // Map to natural image coordinates
    const naturalX = (relX / imgRect.width)  * img.naturalWidth;
    const naturalY = (relY / imgRect.height) * img.naturalHeight;

    const half = loupeSize / 2;
    const srcHalf = half / loupeZoom;

    // Draw the magnified region onto the canvas
    loupeCtx.clearRect(0, 0, loupeSize, loupeSize);

    // Apply same CSS filters to canvas context
    const brightness = document.getElementById('slBrightness').value / 100;
    const contrast   = document.getElementById('slContrast').value / 100;
    loupeCtx.filter = `brightness(${brightness}) contrast(${contrast})${inverted ? ' invert(1)' : ''}`;

    loupeCtx.save();
    loupeCtx.beginPath();
    loupeCtx.arc(half, half, half, 0, Math.PI * 2);
    loupeCtx.clip();

    loupeCtx.drawImage(
        img,
        naturalX - srcHalf, naturalY - srcHalf, srcHalf * 2, srcHalf * 2,
        0, 0, loupeSize, loupeSize
    );
    loupeCtx.restore();

    // Crosshair
    loupeCtx.filter = 'none';
    loupeCtx.strokeStyle = 'rgba(16,185,129,0.6)';
    loupeCtx.lineWidth = 1;
    loupeCtx.beginPath();
    loupeCtx.moveTo(half, half - 8); loupeCtx.lineTo(half, half + 8);
    loupeCtx.moveTo(half - 8, half); loupeCtx.lineTo(half + 8, half);
    loupeCtx.stroke();

    // Position loupe near cursor with offset so it doesn't cover the spot
    const offset = half + 18;
    let lx = cx - areaRect.left + offset;
    let ly = cy - areaRect.top  - half;

    // Flip to left if going off-screen right
    if (lx + loupeSize > areaRect.width)  lx = cx - areaRect.left - offset - loupeSize;
    // Clamp vertically
    ly = Math.max(8, Math.min(areaRect.height - loupeSize - 8, ly));

    loupe.style.left    = lx + 'px';
    loupe.style.top     = ly + 'px';
    loupe.style.display = 'block';
}

// ── Mouse events ──────────────────────────────────────────────────────────────
area.addEventListener('mousemove', e => {
    mousePos = { x: e.clientX, y: e.clientY };

    if (isPanning) {
        translateX = e.clientX - panStart.x;
        translateY = e.clientY - panStart.y;
        applyTransform();
        loupe.style.display = 'none';
        return;
    }

    if (loupeEnabled) drawLoupe(e.clientX, e.clientY);
});

area.addEventListener('mousedown', e => {
    if (e.button !== 0) return;
    isPanning = true;
    panStart = { x: e.clientX - translateX, y: e.clientY - translateY };
    area.classList.add('panning');
    loupe.style.display = 'none';
});
window.addEventListener('mouseup', () => {
    isPanning = false;
    area.classList.remove('panning');
});

area.addEventListener('mouseleave', () => { loupe.style.display = 'none'; });

// ── Touch pan ─────────────────────────────────────────────────────────────────
area.addEventListener('touchstart', e => {
    if (e.touches.length !== 1) return;
    isPanning = true;
    panStart = { x: e.touches[0].clientX - translateX, y: e.touches[0].clientY - translateY };
}, { passive: true });
area.addEventListener('touchmove', e => {
    if (!isPanning || e.touches.length !== 1) return;
    translateX = e.touches[0].clientX - panStart.x;
    translateY = e.touches[0].clientY - panStart.y;
    applyTransform();
}, { passive: true });
area.addEventListener('touchend', () => { isPanning = false; });

// ── Scroll zoom ───────────────────────────────────────────────────────────────
area.addEventListener('wheel', e => {
    e.preventDefault();
    const delta = e.deltaY < 0 ? 0.1 : -0.1;
    scale = Math.max(0.05, Math.min(20, scale + delta * scale));
    applyTransform();
}, { passive: false });

// ── Keyboard shortcuts ────────────────────────────────────────────────────────
document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT') return;
    if (e.key === '+' || e.key === '=') zoom(0.1 * scale);
    else if (e.key === '-') zoom(-0.1 * scale);
    else if (e.key === 'r' || e.key === 'R') rotate(90);
    else if (e.key === 'i' || e.key === 'I') toggleInvert();
    else if (e.key === 'w' || e.key === 'W') fitToWidth();
    else if (e.key === 'f' || e.key === 'F') fitToView();
    else if (e.key === 'l' || e.key === 'L') toggleLoupe();
    else if (e.key === 'Escape') resetAll();
});

// ── Reset ─────────────────────────────────────────────────────────────────────
function resetAll() {
    scale = 1; rotation = 0; flipH = false; flipV = false; inverted = false;
    translateX = 0; translateY = 0;

    document.getElementById('slBrightness').value = 100;
    document.getElementById('slContrast').value   = 100;
    document.getElementById('slSharpness').value  = 0;
    document.getElementById('valBrightness').textContent = '100%';
    document.getElementById('valContrast').textContent   = '100%';
    document.getElementById('valSharpness').textContent  = '0';
    document.getElementById('btnInvert').classList.remove('active');
    document.getElementById('btnFlipH').classList.remove('active');
    document.getElementById('btnFlipV').classList.remove('active');
    img.style.filter = '';

    fitToWidth();
}

// Init loupe canvas size
loupeCanvas.width  = loupeSize;
loupeCanvas.height = loupeSize;
loupe.style.width  = loupeSize + 'px';
loupe.style.height = loupeSize + 'px';
</script>
</body>
