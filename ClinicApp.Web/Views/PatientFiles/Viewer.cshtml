@using ClinicApp.Web.ViewModels
@using ClinicApp.Web.Services.Storage
@model PatientFileViewerViewModel

@{
    Layout = null;
    var ext = Model.Extension.ToLowerInvariant();
    var isGltf = ext == ".glb" || ext == ".gltf";
    var streamUrl = $"/patients/{Model.PatientId}/files/{Model.FileId}/stream";
    var backUrl = $"/patients/{Model.PatientId}/files";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>3D Viewer — @Model.OriginalFileName</title>

    @if (isGltf)
    {
        <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>
    }
    else
    {
        <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
        @if (ext == ".stl")
        {
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js"></script>
        }
        else if (ext == ".obj")
        {
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/OBJLoader.js"></script>
        }
        else if (ext == ".ply")
        {
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/PLYLoader.js"></script>
        }
    }

    <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; font-family: system-ui, -apple-system, sans-serif; background: #f8fafc; }

    .viewer-shell { display: flex; height: 100vh; }

    /* ── Side panel ── */
    .viewer-panel {
        width: 290px; flex-shrink: 0;
        background: #ffffff; border-right: 1px solid #e2e8f0;
        display: flex; flex-direction: column;
        padding: 1.25rem; gap: 1.1rem; overflow-y: auto;
        color: #1e293b;
    }

    .panel-back {
        display: inline-flex; align-items: center; gap: .4rem;
        color: #10b981; text-decoration: none; font-size: .83rem; font-weight: 500;
        background: #f0fdf4; padding: .45rem .8rem;
        border-radius: 8px; border: 1px solid #bbf7d0;
        transition: background .15s;
    }
    .panel-back:hover { background: #dcfce7; }

    .panel-title { font-size: .93rem; font-weight: 600; color: #0f172a; word-break: break-all; line-height: 1.4; }

    .panel-badge {
        display: inline-block; margin-top: .35rem;
        padding: .2rem .65rem; border-radius: 999px;
        font-size: .7rem; font-weight: 600; letter-spacing: .02em;
        background: #f0fdf4; color: #059669; border: 1px solid #bbf7d0;
    }

    .panel-divider { height: 1px; background: #e2e8f0; }

    .panel-meta { display: flex; flex-direction: column; gap: .45rem; }
    .meta-row { display: flex; justify-content: space-between; align-items: baseline; font-size: .8rem; gap: .5rem; }
    .meta-label { color: #64748b; white-space: nowrap; }
    .meta-value { color: #1e293b; font-weight: 500; text-align: right; }

    .panel-notes {
        font-size: .8rem; color: #475569; background: #f8fafc;
        border-radius: 8px; padding: .65rem; border: 1px solid #e2e8f0; line-height: 1.5;
    }

    /* ── Background color picker ── */
    .bg-picker-label {
        font-size: .75rem; font-weight: 600; color: #64748b;
        text-transform: uppercase; letter-spacing: .06em; margin-bottom: .45rem;
    }
    .bg-swatches {
        display: flex; flex-wrap: wrap; gap: .45rem;
    }
    .swatch {
        width: 28px; height: 28px; border-radius: 6px; cursor: pointer;
        border: 2px solid transparent; transition: transform .12s, border-color .12s;
        box-shadow: 0 1px 3px rgba(0,0,0,.2);
        flex-shrink: 0;
    }
    .swatch:hover { transform: scale(1.15); }
    .swatch.active { border-color: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,.25); }

    /* ── Action buttons ── */
    .panel-actions { display: flex; flex-direction: column; gap: .5rem; margin-top: auto; }
    .btn-panel {
        padding: .52rem .9rem; border-radius: 8px; border: none; cursor: pointer;
        font-size: .82rem; font-weight: 500; text-align: center; text-decoration: none;
        display: block; transition: background .15s, color .15s;
    }
    .btn-reset {
        background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;
    }
    .btn-reset:hover { background: #e2e8f0; color: #1e293b; }
    .btn-dl {
        background: #10b981; color: #ffffff; border: 1px solid #059669;
    }
    .btn-dl:hover { background: #059669; }

    /* ── Viewer area ── */
    .viewer-area { flex: 1; position: relative; overflow: hidden; }
    #canvas-container { width: 100%; height: 100%; }
    model-viewer { width: 100%; height: 100%; --mv-theme-primary: #10b981; }

    /* ── Loading overlay ── */
    .viewer-loading {
        position: absolute; inset: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 1rem; pointer-events: none; transition: opacity .3s;
        background: #0a0a0a; color: #94a3b8;
    }
    .viewer-loading.hidden { opacity: 0; }
    .spinner {
        width: 44px; height: 44px; border: 3px solid rgba(16,185,129,.2);
        border-top-color: #10b981; border-radius: 50%; animation: spin .8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .viewer-error {
        position: absolute; inset: 0;
        display: none; flex-direction: column; align-items: center; justify-content: center;
        color: #f87171; gap: .75rem; text-align: center; padding: 2rem; background: #0a0a0a;
    }
    .viewer-error.visible { display: flex; }
    .viewer-error a { color: #10b981; font-size: .85rem; }

    .controls-hint {
        position: absolute; bottom: 1rem; right: 1rem;
        background: rgba(0,0,0,.55); color: #cbd5e1; border-radius: 8px;
        padding: .45rem .7rem; font-size: .7rem; line-height: 1.7;
        pointer-events: none; backdrop-filter: blur(4px);
    }
    </style>
</head>
<body>
<div class="viewer-shell">

    <!-- Side panel -->
    <aside class="viewer-panel">

        <a href="@backUrl" class="panel-back">← Back to Files</a>

        <div>
            <div class="panel-title">@Model.OriginalFileName</div>
            <span class="panel-badge">@PatientFileHelper.GetDisplayName(Model.Category)</span>
        </div>

        <div class="panel-divider"></div>

        <div class="panel-meta">
            <div class="meta-row">
                <span class="meta-label">Patient</span>
                <span class="meta-value">@Model.PatientFirstName @Model.PatientLastName</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Format</span>
                <span class="meta-value">@Model.Extension.ToUpper()</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Size</span>
                <span class="meta-value">@PatientFileHelper.GetHumanReadableFileSize(Model.Size)</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Uploaded</span>
                <span class="meta-value">@Model.UploadedAtUtc.ToString("MMM dd, yyyy")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="panel-notes">@Model.Notes</div>
        }

        <div class="panel-divider"></div>

        <!-- Background color picker -->
        <div>
            <div class="bg-picker-label">Background Color</div>
            <div class="bg-swatches" id="bgSwatches">
                <div class="swatch active" data-color="#0a0a0a" title="Midnight Black"  style="background:#0a0a0a;"></div>
                <div class="swatch"        data-color="#0f172a" title="Deep Navy"       style="background:#0f172a;"></div>
                <div class="swatch"        data-color="#1e3a5f" title="Ocean Blue"      style="background:#1e3a5f;"></div>
                <div class="swatch"        data-color="#334155" title="Slate Grey"      style="background:#334155;"></div>
                <div class="swatch"        data-color="#78350f" title="Deep Amber"      style="background:#78350f;"></div>
                <div class="swatch"        data-color="#064e3b" title="Forest Green"    style="background:#064e3b;"></div>
                <div class="swatch"        data-color="#e2e8f0" title="Soft Silver"     style="background:#e2e8f0; border: 1px solid #cbd5e1;"></div>
                <div class="swatch"        data-color="#ffffff" title="Pure White"      style="background:#ffffff; border: 1px solid #e2e8f0;"></div>
            </div>
        </div>

        <div class="panel-actions">
            @if (!isGltf)
            {
                <button class="btn-panel btn-reset" onclick="resetCamera()">Reset Camera</button>
            }
            <a href="@streamUrl" download="@Model.OriginalFileName" class="btn-panel btn-dl">Download File</a>
        </div>

    </aside>

    <!-- 3D Viewer area -->
    <div class="viewer-area">

        <div class="viewer-loading" id="loadingOverlay">
            <div class="spinner"></div>
            <span style="font-size:.85rem;">Loading 3D model…</span>
        </div>

        <div class="viewer-error" id="errorOverlay">
            <span style="font-size:2rem;">⚠️</span>
            <span id="errorMsg">Failed to load 3D model.</span>
            <a href="@backUrl">← Back to files</a>
        </div>

        @if (isGltf)
        {
            <model-viewer
                id="modelViewer"
                src="@streamUrl"
                camera-controls
                auto-rotate
                auto-rotate-delay="2000"
                shadow-intensity="1"
                environment-image="neutral"
                exposure="1"
                style="width:100%;height:100%;background:#0a0a0a;">
                <div slot="progress-bar"></div>
            </model-viewer>
        }
        else
        {
            <div id="canvas-container"></div>
        }

        @if (!isGltf)
        {
            <div class="controls-hint">
                🖱 Drag to rotate &nbsp;|&nbsp; Scroll to zoom &nbsp;|&nbsp; Right-drag to pan
            </div>
        }

    </div>
</div>

<script>
// ── Background color picker (shared for both viewer types) ────────────────────
(function () {
    const swatches = document.querySelectorAll('#bgSwatches .swatch');
    swatches.forEach(sw => {
        sw.addEventListener('click', () => {
            swatches.forEach(s => s.classList.remove('active'));
            sw.classList.add('active');
            const color = sw.dataset.color;
            setBgColor(color);
        });
    });
})();

@if (isGltf)
{
    <text>
// ── GLB / GLTF via model-viewer ───────────────────────────────────────────────
const mv = document.getElementById('modelViewer');
const overlay = document.getElementById('loadingOverlay');

function setBgColor(hex) {
    mv.style.background = hex;
    mv.style.setProperty('--mv-background', hex);
    document.getElementById('loadingOverlay').style.background = hex;
}

mv.addEventListener('load', () => overlay.classList.add('hidden'));
mv.addEventListener('error', () => {
    overlay.classList.add('hidden');
    const err = document.getElementById('errorOverlay');
    err.classList.add('visible');
    err.style.background = mv.style.background || '#0a0a0a';
    document.getElementById('errorMsg').textContent = 'Failed to load GLB/GLTF model.';
});
    </text>
}
else
{
    <text>
// ── STL / OBJ / PLY via Three.js ─────────────────────────────────────────────
const streamUrl = '@streamUrl';
const ext = '@ext';
const overlay = document.getElementById('loadingOverlay');
const errorOverlay = document.getElementById('errorOverlay');

let camera, controls, renderer, scene, loadedObject;
let currentBgHex = '#0a0a0a';

function setBgColor(hex) {
    currentBgHex = hex;
    if (scene) scene.background = new THREE.Color(hex);
    overlay.style.background = hex;
}

function init() {
    const container = document.getElementById('canvas-container');
    const w = container.clientWidth, h = container.clientHeight;

    scene = new THREE.Scene();
    scene.background = new THREE.Color(currentBgHex);

    camera = new THREE.PerspectiveCamera(45, w / h, 0.001, 100000);
    camera.position.set(0, 0, 5);

    renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(w, h);
    renderer.shadowMap.enabled = true;
    container.appendChild(renderer.domElement);

    const ambient = new THREE.AmbientLight(0xffffff, 0.6);
    scene.add(ambient);
    const dir1 = new THREE.DirectionalLight(0xffffff, 0.9);
    dir1.position.set(5, 10, 7);
    scene.add(dir1);
    const dir2 = new THREE.DirectionalLight(0xaabbff, 0.4);
    dir2.position.set(-5, -5, -5);
    scene.add(dir2);
    const hemi = new THREE.HemisphereLight(0xffffff, 0x444466, 0.4);
    scene.add(hemi);

    controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.screenSpacePanning = true;
    controls.minDistance = 0.01;
    controls.maxDistance = 100000;

    window.addEventListener('resize', onResize);
    animate();
    loadModel();
}

function onResize() {
    const container = document.getElementById('canvas-container');
    camera.aspect = container.clientWidth / container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
}

function fitCameraToObject(object) {
    const box = new THREE.Box3().setFromObject(object);
    const center = box.getCenter(new THREE.Vector3());
    const size = box.getSize(new THREE.Vector3());

    object.position.sub(center);

    const maxDim = Math.max(size.x, size.y, size.z);
    const fov = camera.fov * (Math.PI / 180);
    const dist = maxDim / (2 * Math.tan(fov / 2)) * 1.5;

    camera.position.set(0, 0, dist);
    camera.near = dist / 1000;
    camera.far = dist * 1000;
    camera.updateProjectionMatrix();

    controls.target.set(0, 0, 0);
    controls.update();
}

function loadModel() {
    if (ext === '.stl') {
        const loader = new THREE.STLLoader();
        loader.load(streamUrl,
            (geometry) => {
                geometry.computeVertexNormals();
                const mat = new THREE.MeshPhongMaterial({ color: 0x9daeff, specular: 0x222244, shininess: 80 });
                const mesh = new THREE.Mesh(geometry, mat);
                loadedObject = new THREE.Group();
                loadedObject.add(mesh);
                scene.add(loadedObject);
                fitCameraToObject(loadedObject);
                overlay.classList.add('hidden');
            },
            null,
            (err) => showError('Failed to load STL: ' + err.message)
        );

    } else if (ext === '.obj') {
        const loader = new THREE.OBJLoader();
        loader.load(streamUrl,
            (object) => {
                object.traverse((child) => {
                    if (child.isMesh && !child.material?.color) {
                        child.material = new THREE.MeshPhongMaterial({ color: 0x9daeff });
                    }
                });
                loadedObject = object;
                scene.add(loadedObject);
                fitCameraToObject(loadedObject);
                overlay.classList.add('hidden');
            },
            null,
            (err) => showError('Failed to load OBJ: ' + err.message)
        );

    } else if (ext === '.ply') {
        const loader = new THREE.PLYLoader();
        loader.load(streamUrl,
            (geometry) => {
                geometry.computeVertexNormals();
                const hasColor = geometry.hasAttribute('color');
                const mat = hasColor
                    ? new THREE.MeshStandardMaterial({ vertexColors: true })
                    : new THREE.MeshPhongMaterial({ color: 0x9daeff, specular: 0x222244, shininess: 80 });
                const mesh = new THREE.Mesh(geometry, mat);
                loadedObject = new THREE.Group();
                loadedObject.add(mesh);
                scene.add(loadedObject);
                fitCameraToObject(loadedObject);
                overlay.classList.add('hidden');
            },
            null,
            (err) => showError('Failed to load PLY: ' + err.message)
        );
    }
}

function showError(msg) {
    overlay.classList.add('hidden');
    errorOverlay.classList.add('visible');
    document.getElementById('errorMsg').textContent = msg;
}

function resetCamera() {
    if (loadedObject) fitCameraToObject(loadedObject);
}

function animate() {
    requestAnimationFrame(animate);
    controls.update();
    renderer.render(scene, camera);
}

init();
    </text>
}
</script>

</body>
</html>
