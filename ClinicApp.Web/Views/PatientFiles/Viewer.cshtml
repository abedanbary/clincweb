@using ClinicApp.Web.ViewModels
@using ClinicApp.Web.Services.Storage
@model PatientFileViewerViewModel

@{
    Layout = null; // Full-page immersive viewer
    var ext = Model.Extension.ToLowerInvariant();
    var isGltf = ext == ".glb" || ext == ".gltf";
    var streamUrl = $"/patients/{Model.PatientId}/files/{Model.FileId}/stream";
    var backUrl = $"/patients/{Model.PatientId}/files";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>3D Viewer — @Model.OriginalFileName</title>

    @if (isGltf)
    {
        <!-- model-viewer web component for GLB/GLTF -->
        <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>
    }
    else
    {
        <!-- Three.js r128 for STL / OBJ / PLY -->
        <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
        @if (ext == ".stl")
        {
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js"></script>
        }
        else if (ext == ".obj")
        {
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/OBJLoader.js"></script>
        }
        else if (ext == ".ply")
        {
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/PLYLoader.js"></script>
        }
    }

    <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; font-family: system-ui, -apple-system, sans-serif; }

    .viewer-shell { display: flex; height: 100vh; background: #0f0f1a; }

    /* Side panel */
    .viewer-panel {
        width: 280px; flex-shrink: 0;
        background: #1a1a2e; border-right: 1px solid #2d2d44;
        display: flex; flex-direction: column;
        padding: 1.2rem; gap: 1rem; overflow-y: auto;
        color: #e2e8f0;
    }
    .panel-back {
        display: inline-flex; align-items: center; gap: .4rem;
        color: #818cf8; text-decoration: none; font-size: .85rem;
        background: rgba(99,102,241,.1); padding: .4rem .75rem;
        border-radius: 8px; border: 1px solid rgba(99,102,241,.2);
    }
    .panel-back:hover { background: rgba(99,102,241,.2); }
    .panel-title { font-size: .95rem; font-weight: 600; color: #f8fafc; word-break: break-all; }
    .panel-badge {
        display: inline-block; padding: .2rem .6rem; border-radius: 999px;
        font-size: .72rem; font-weight: 500;
        background: rgba(99,102,241,.2); color: #818cf8;
    }
    .panel-meta { display: flex; flex-direction: column; gap: .4rem; }
    .meta-row { display: flex; justify-content: space-between; font-size: .8rem; }
    .meta-label { color: #94a3b8; }
    .meta-value { color: #e2e8f0; font-weight: 500; }
    .panel-notes {
        font-size: .8rem; color: #cbd5e1; background: rgba(255,255,255,.05);
        border-radius: 8px; padding: .6rem; border: 1px solid rgba(255,255,255,.08);
    }
    .panel-actions { display: flex; flex-direction: column; gap: .5rem; }
    .btn-panel {
        padding: .5rem .9rem; border-radius: 8px; border: none; cursor: pointer;
        font-size: .82rem; font-weight: 500; text-align: center; text-decoration: none;
    }
    .btn-reset   { background: rgba(255,255,255,.08); color: #e2e8f0; }
    .btn-reset:hover { background: rgba(255,255,255,.14); }
    .btn-dl      { background: rgba(34,197,94,.15); color: #4ade80; border: 1px solid rgba(34,197,94,.25); }
    .btn-dl:hover { background: rgba(34,197,94,.25); }

    /* Viewer area */
    .viewer-area { flex: 1; position: relative; }
    #canvas-container { width: 100%; height: 100%; }
    model-viewer { width: 100%; height: 100%; --mv-theme-primary: #6366f1; }

    /* Loading overlay */
    .viewer-loading {
        position: absolute; inset: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        color: #94a3b8; gap: 1rem; background: #0f0f1a;
        pointer-events: none; transition: opacity .3s;
    }
    .viewer-loading.hidden { opacity: 0; }
    .spinner {
        width: 44px; height: 44px; border: 3px solid rgba(99,102,241,.2);
        border-top-color: #6366f1; border-radius: 50%; animation: spin .8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .viewer-error {
        position: absolute; inset: 0;
        display: none; flex-direction: column; align-items: center; justify-content: center;
        color: #f87171; gap: .75rem; text-align: center; padding: 2rem;
    }
    .viewer-error.visible { display: flex; }

    /* Controls hint */
    .controls-hint {
        position: absolute; bottom: 1rem; right: 1rem;
        background: rgba(0,0,0,.5); color: #94a3b8; border-radius: 8px;
        padding: .5rem .75rem; font-size: .72rem; line-height: 1.6;
        pointer-events: none;
    }
    </style>
</head>
<body>
<div class="viewer-shell">

    <!-- Side panel -->
    <aside class="viewer-panel">
        <a href="@backUrl" class="panel-back">← Back to Files</a>

        <div>
            <div class="panel-title">@Model.OriginalFileName</div>
            <div style="margin-top:.4rem;">
                <span class="panel-badge">@PatientFileHelper.GetDisplayName(Model.Category)</span>
            </div>
        </div>

        <div class="panel-meta">
            <div class="meta-row">
                <span class="meta-label">Patient</span>
                <span class="meta-value">@Model.PatientFirstName @Model.PatientLastName</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Format</span>
                <span class="meta-value">@Model.Extension.ToUpper()</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Size</span>
                <span class="meta-value">@PatientFileHelper.GetHumanReadableFileSize(Model.Size)</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Uploaded</span>
                <span class="meta-value">@Model.UploadedAtUtc.ToString("MMM dd, yyyy")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="panel-notes">@Model.Notes</div>
        }

        <div class="panel-actions">
            @if (!isGltf)
            {
                <button id="btnReset" class="btn-panel btn-reset" onclick="resetCamera()">Reset Camera</button>
            }
            <a href="@streamUrl" download="@Model.OriginalFileName" class="btn-panel btn-dl">Download File</a>
        </div>
    </aside>

    <!-- 3D Viewer area -->
    <div class="viewer-area">

        <div class="viewer-loading" id="loadingOverlay">
            <div class="spinner"></div>
            <span>Loading 3D model…</span>
        </div>

        <div class="viewer-error" id="errorOverlay">
            <span style="font-size:2rem;">⚠️</span>
            <span id="errorMsg">Failed to load 3D model.</span>
            <a href="@backUrl" style="color:#818cf8;font-size:.85rem;">← Back to files</a>
        </div>

        @if (isGltf)
        {
            <model-viewer
                id="modelViewer"
                src="@streamUrl"
                camera-controls
                auto-rotate
                auto-rotate-delay="2000"
                shadow-intensity="1"
                environment-image="neutral"
                exposure="1"
                style="width:100%;height:100%;background:#0f0f1a;">
                <div slot="progress-bar"></div>
            </model-viewer>
        }
        else
        {
            <div id="canvas-container"></div>
        }

        @if (!isGltf)
        {
            <div class="controls-hint">
                🖱 Drag to rotate &nbsp;|&nbsp; Scroll to zoom &nbsp;|&nbsp; Right-drag to pan
            </div>
        }
    </div>

</div>

@if (isGltf)
{
    <script>
    const mv = document.getElementById('modelViewer');
    const overlay = document.getElementById('loadingOverlay');
    mv.addEventListener('load', () => overlay.classList.add('hidden'));
    mv.addEventListener('error', () => {
        overlay.classList.add('hidden');
        document.getElementById('errorOverlay').classList.add('visible');
        document.getElementById('errorMsg').textContent = 'Failed to load GLB/GLTF model.';
    });
    </script>
}
else
{
    <script>
    const streamUrl = '@streamUrl';
    const ext = '@ext';
    const overlay = document.getElementById('loadingOverlay');
    const errorOverlay = document.getElementById('errorOverlay');

    let camera, controls, renderer, scene, loadedObject;

    function init() {
        const container = document.getElementById('canvas-container');
        const w = container.clientWidth, h = container.clientHeight;

        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x0f0f1a);

        camera = new THREE.PerspectiveCamera(45, w / h, 0.001, 100000);
        camera.position.set(0, 0, 5);

        renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.setSize(w, h);
        renderer.shadowMap.enabled = true;
        container.appendChild(renderer.domElement);

        // Lights
        const ambient = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambient);
        const dir1 = new THREE.DirectionalLight(0xffffff, 0.9);
        dir1.position.set(5, 10, 7);
        scene.add(dir1);
        const dir2 = new THREE.DirectionalLight(0xaabbff, 0.4);
        dir2.position.set(-5, -5, -5);
        scene.add(dir2);
        const hemi = new THREE.HemisphereLight(0xffffff, 0x444466, 0.4);
        scene.add(hemi);

        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.screenSpacePanning = true;
        controls.minDistance = 0.01;
        controls.maxDistance = 100000;

        window.addEventListener('resize', onResize);
        animate();
        loadModel();
    }

    function onResize() {
        const container = document.getElementById('canvas-container');
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    }

    function fitCameraToObject(object) {
        const box = new THREE.Box3().setFromObject(object);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3());

        object.position.sub(center); // center model at origin

        const maxDim = Math.max(size.x, size.y, size.z);
        const fov = camera.fov * (Math.PI / 180);
        const dist = maxDim / (2 * Math.tan(fov / 2)) * 1.5;

        camera.position.set(0, 0, dist);
        camera.near = dist / 1000;
        camera.far = dist * 1000;
        camera.updateProjectionMatrix();

        controls.target.set(0, 0, 0);
        controls.update();
    }

    function loadModel() {
        if (ext === '.stl') {
            const loader = new THREE.STLLoader();
            loader.load(streamUrl,
                (geometry) => {
                    geometry.computeVertexNormals();
                    const mat = new THREE.MeshPhongMaterial({ color: 0x9daeff, specular: 0x222244, shininess: 80 });
                    const mesh = new THREE.Mesh(geometry, mat);
                    loadedObject = new THREE.Group();
                    loadedObject.add(mesh);
                    scene.add(loadedObject);
                    fitCameraToObject(loadedObject);
                    overlay.classList.add('hidden');
                },
                null,
                (err) => showError('Failed to load STL: ' + err.message)
            );

        } else if (ext === '.obj') {
            const loader = new THREE.OBJLoader();
            loader.load(streamUrl,
                (object) => {
                    // Apply default material if none loaded
                    object.traverse((child) => {
                        if (child.isMesh && !child.material?.color) {
                            child.material = new THREE.MeshPhongMaterial({ color: 0x9daeff });
                        }
                    });
                    loadedObject = object;
                    scene.add(loadedObject);
                    fitCameraToObject(loadedObject);
                    overlay.classList.add('hidden');
                },
                null,
                (err) => showError('Failed to load OBJ: ' + err.message)
            );

        } else if (ext === '.ply') {
            const loader = new THREE.PLYLoader();
            loader.load(streamUrl,
                (geometry) => {
                    geometry.computeVertexNormals();
                    const hasColor = geometry.hasAttribute('color');
                    const mat = hasColor
                        ? new THREE.MeshStandardMaterial({ vertexColors: true })
                        : new THREE.MeshPhongMaterial({ color: 0x9daeff, specular: 0x222244, shininess: 80 });
                    const mesh = new THREE.Mesh(geometry, mat);
                    loadedObject = new THREE.Group();
                    loadedObject.add(mesh);
                    scene.add(loadedObject);
                    fitCameraToObject(loadedObject);
                    overlay.classList.add('hidden');
                },
                null,
                (err) => showError('Failed to load PLY: ' + err.message)
            );
        }
    }

    function showError(msg) {
        overlay.classList.add('hidden');
        errorOverlay.classList.add('visible');
        document.getElementById('errorMsg').textContent = msg;
    }

    function resetCamera() {
        if (loadedObject) fitCameraToObject(loadedObject);
    }

    function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
    }

    init();
    </script>
}
</body>
</html>
