@using ClinicApp.Web.Models
@using ClinicApp.Web.ViewModels
@model TreatmentPaymentsPageViewModel

@{
    Layout = User.IsInRole("Manager") ? "_ManagerLayout" : "_DoctorLayout";
    ViewData["Title"] = $"Payments — {Model.Treatment.Title}";
    var isManager = User.IsInRole("Manager");
    var today = DateTime.UtcNow.Date;
}

<link rel="stylesheet" href="~/css/payments.css" />

<style>
.tp-page      { padding: 24px; max-width: 1200px; display: flex; flex-direction: column; gap: 20px; }
.tp-back      { display: inline-flex; align-items: center; gap: .4rem; color: #10b981; text-decoration: none;
                font-size: .83rem; font-weight: 500; background: #f0fdf4; padding: .4rem .85rem;
                border-radius: 8px; border: 1px solid #bbf7d0; }
.tp-back:hover { background: #dcfce7; }

.tp-title-row { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.tp-title     { font-size: 1.5rem; font-weight: 700; color: #0f172a; }
.tp-sub       { font-size: .88rem; color: #64748b; margin-top: 3px; }

/* Type / Status badges */
.tp-badge     { display: inline-block; padding: .2rem .65rem; border-radius: 20px; font-size: .72rem; font-weight: 600; }
.tp-badge-type     { background: #eff6ff; color: #1d4ed8; }
.tp-badge-planned  { background: #f1f5f9; color: #475569; }
.tp-badge-inprogress { background: #fef9c3; color: #854d0e; }
.tp-badge-completed  { background: #dcfce7; color: #15803d; }
.tp-badge-cancelled  { background: #fee2e2; color: #b91c1c; }

/* Top cards grid */
.tp-cards     { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
@@media (max-width: 700px) { .tp-cards { grid-template-columns: 1fr; } }

.tp-card      { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 24px; }
.tp-card-title { font-size: .75rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 18px; }

/* Financial summary */
.tp-fin-grid  { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.tp-fin-item  { }
.tp-fin-label { font-size: .75rem; color: #9ca3af; margin-bottom: 3px; }
.tp-fin-value { font-size: 1.35rem; font-weight: 700; color: #0f172a; }
.tp-fin-value.green  { color: #059669; }
.tp-fin-value.orange { color: #ea580c; }

.tp-progress-bar-wrap { margin-top: 18px; }
.tp-progress-label    { display: flex; justify-content: space-between; font-size: .78rem; color: #6b7280; margin-bottom: 6px; }
.tp-progress-track    { height: 10px; background: #e5e7eb; border-radius: 99px; overflow: hidden; }
.tp-progress-fill     { height: 100%; border-radius: 99px; background: linear-gradient(90deg, #10b981, #059669);
                         transition: width .4s ease; }

/* Detail card */
.tp-detail-row  { display: flex; gap: 10px; padding: 9px 0; border-bottom: 1px solid #f3f4f6; font-size: .875rem; }
.tp-detail-row:last-child { border-bottom: none; }
.tp-detail-label { width: 120px; color: #6b7280; flex-shrink: 0; }
.tp-detail-value { color: #111827; font-weight: 500; }

/* Payment history */
.tp-history-card  { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; }
.tp-history-header { display: flex; align-items: center; justify-content: space-between;
                     padding: 16px 20px; border-bottom: 1px solid #e5e7eb; }
.tp-history-title  { font-size: 1rem; font-weight: 600; color: #111827; }

.tp-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
.tp-table th { padding: 11px 16px; text-align: left; font-size: .72rem; font-weight: 600; color: #6b7280;
               text-transform: uppercase; letter-spacing: .04em; background: #f9fafb;
               border-bottom: 1px solid #e5e7eb; }
.tp-table td { padding: 13px 16px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
.tp-table tr:last-child td { border-bottom: none; }
.tp-table tr:hover td { background: #fafafa; }

.tp-status-paid     { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .72rem; font-weight: 600; background: #dcfce7; color: #15803d; }
.tp-status-pending  { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .72rem; font-weight: 600; background: #fff7ed; color: #c2410c; }
.tp-status-overdue  { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .72rem; font-weight: 600; background: #fee2e2; color: #b91c1c; }
.tp-status-refunded { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .72rem; font-weight: 600; background: #f1f5f9; color: #475569; }

.tp-method { font-size: .8rem; color: #6b7280; }

.tp-empty { text-align: center; padding: 40px 20px; color: #9ca3af; font-size: .9rem; }

/* Modal form */
.tp-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: flex;
                    align-items: center; justify-content: center; z-index: 1000; padding: 16px; }
.tp-modal         { background: #fff; border-radius: 16px; width: 100%; max-width: 520px;
                    max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.15); }
.tp-modal-header  { display: flex; justify-content: space-between; align-items: center;
                    padding: 20px 24px 16px; border-bottom: 1px solid #e5e7eb; }
.tp-modal-title   { font-size: 1.1rem; font-weight: 700; }
.tp-modal-close   { background: none; border: none; font-size: 22px; cursor: pointer; color: #6b7280; }
.tp-modal-body    { padding: 20px 24px; display: flex; flex-direction: column; gap: 16px; }
.tp-modal-footer  { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px 20px; border-top: 1px solid #e5e7eb; }

.tp-form-row      { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.tp-form-group    { display: flex; flex-direction: column; gap: 5px; }
.tp-form-label    { font-size: .82rem; font-weight: 600; color: #374151; }
.tp-form-input, .tp-form-select, .tp-form-textarea {
    padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px;
    font-size: .875rem; color: #111827; background: #fff; outline: none;
    transition: border-color .15s; width: 100%;
}
.tp-form-input:focus, .tp-form-select:focus { border-color: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,.1); }
.tp-remaining-hint { font-size: .78rem; color: #6b7280; margin-top: 3px; }
.tp-remaining-hint.warn { color: #ea580c; font-weight: 600; }
</style>

<div class="tp-page">

    <!-- Back -->
    <div>
        <a asp-controller="Patients" asp-action="Profile" asp-route-id="@Model.Patient.Id" class="tp-back">
            &larr; Back to Patient
        </a>
    </div>

    <!-- Toasts -->
    @if (TempData["Success"] != null)
    {
        <div class="pay-toast pay-toast-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="pay-toast pay-toast-error">@TempData["Error"]</div>
    }

    <!-- Title row -->
    <div class="tp-title-row">
        <div>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px;">
                <span class="tp-badge tp-badge-type">@Model.Treatment.Type</span>
                @{
                    var statusClass = Model.Treatment.Status switch {
                        TreatmentStatus.Planned => "planned",
                        TreatmentStatus.InProgress => "inprogress",
                        TreatmentStatus.Completed => "completed",
                        TreatmentStatus.Cancelled => "cancelled",
                        _ => "planned"
                    };
                }
                <span class="tp-badge tp-badge-@statusClass">@Model.Treatment.Status</span>
                @if (Model.Treatment.ToothNumber.HasValue)
                {
                    <span class="tp-badge" style="background:#f0fdf4;color:#15803d;">Tooth #@Model.Treatment.ToothNumber</span>
                }
            </div>
            <h1 class="tp-title">@Model.Treatment.Title</h1>
            <p class="tp-sub">
                @Model.Patient.FirstName @Model.Patient.LastName
                &nbsp;&middot;&nbsp;
                Dr. @Model.Treatment.Doctor.FirstName @Model.Treatment.Doctor.LastName
            </p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
            @if (isManager)
            {
                <button class="btn-primary" onclick="openAddModal()">+ Add Payment</button>
                <a asp-action="ExportPatientReport" asp-route-patientId="@Model.Patient.Id"
                   class="btn-ghost" title="Export all payments for this patient">Export Report</a>
            }
        </div>
    </div>

    <!-- Top cards: Financial + Details -->
    <div class="tp-cards">

        <!-- Financial summary -->
        <div class="tp-card">
            <div class="tp-card-title">Financial Summary</div>
            <div class="tp-fin-grid">
                <div class="tp-fin-item">
                    <div class="tp-fin-label">Total Cost</div>
                    <div class="tp-fin-value">$@Model.TotalCost.ToString("N2")</div>
                </div>
                <div class="tp-fin-item">
                    <div class="tp-fin-label">Total Paid</div>
                    <div class="tp-fin-value green">$@Model.TotalPaid.ToString("N2")</div>
                </div>
                <div class="tp-fin-item">
                    <div class="tp-fin-label">Remaining Balance</div>
                    <div class="tp-fin-value @(Model.Remaining > 0 ? "orange" : "green")">$@Model.Remaining.ToString("N2")</div>
                </div>
                <div class="tp-fin-item">
                    <div class="tp-fin-label">Scheduled Pending</div>
                    <div class="tp-fin-value" style="color:#6b7280;">$@Model.TotalPending.ToString("N2")</div>
                </div>
            </div>
            <div class="tp-progress-bar-wrap">
                <div class="tp-progress-label">
                    <span>Payment Progress</span>
                    <span>@Model.ProgressPercent%</span>
                </div>
                <div class="tp-progress-track">
                    <div class="tp-progress-fill" style="width:@Model.ProgressPercent%;"></div>
                </div>
            </div>
        </div>

        <!-- Treatment details -->
        <div class="tp-card">
            <div class="tp-card-title">Treatment Details</div>
            <div class="tp-detail-row">
                <span class="tp-detail-label">Doctor</span>
                <span class="tp-detail-value">Dr. @Model.Treatment.Doctor.FirstName @Model.Treatment.Doctor.LastName</span>
            </div>
            <div class="tp-detail-row">
                <span class="tp-detail-label">Treatment Date</span>
                <span class="tp-detail-value">@Model.Treatment.TreatmentDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
            </div>
            @if (Model.Treatment.CompletedAt.HasValue)
            {
                <div class="tp-detail-row">
                    <span class="tp-detail-label">Completed</span>
                    <span class="tp-detail-value">@Model.Treatment.CompletedAt.Value.ToLocalTime().ToString("MMM dd, yyyy")</span>
                </div>
            }
            <div class="tp-detail-row">
                <span class="tp-detail-label">Type</span>
                <span class="tp-detail-value">@Model.Treatment.Type</span>
            </div>
            @if (Model.Treatment.ToothNumber.HasValue)
            {
                <div class="tp-detail-row">
                    <span class="tp-detail-label">Tooth</span>
                    <span class="tp-detail-value">#@Model.Treatment.ToothNumber (FDI)</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Treatment.Description))
            {
                <div class="tp-detail-row">
                    <span class="tp-detail-label">Notes</span>
                    <span class="tp-detail-value" style="color:#4b5563;">@Model.Treatment.Description</span>
                </div>
            }
            <div class="tp-detail-row">
                <span class="tp-detail-label">Payments</span>
                <span class="tp-detail-value">
                    @Model.Payments.Count(p => p.Status == PaymentStatus.Paid) paid,
                    @Model.Payments.Count(p => p.Status == PaymentStatus.Pending) pending
                </span>
            </div>
        </div>
    </div>

    <!-- Payment history -->
    <div class="tp-history-card">
        <div class="tp-history-header">
            <span class="tp-history-title">Payment History</span>
            <span style="font-size:.82rem;color:#6b7280;">@Model.Payments.Count record(s)</span>
        </div>

        @if (!Model.Payments.Any())
        {
            <div class="tp-empty">
                No payments recorded yet.
                @if (isManager)
                {
                    <br /><small>Click "+ Add Payment" to record the first installment.</small>
                }
            </div>
        }
        else
        {
            <table class="tp-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th style="text-align:right;">Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Doctor</th>
                        <th>Notes</th>
                        @if (isManager) { <th style="text-align:right;">Actions</th> }
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var p in Model.Payments)
                    {
                        var isOverdue = p.Status == PaymentStatus.Pending && p.PaymentDate.Date < today;
                        var statusLabel = isOverdue ? "Overdue" : p.Status.ToString();
                        var statusCss   = isOverdue ? "overdue" :
                                          p.Status == PaymentStatus.Paid ? "paid" :
                                          p.Status == PaymentStatus.Refunded ? "refunded" : "pending";
                        <tr>
                            <td style="color:#9ca3af;font-size:.78rem;">@(idx++)</td>
                            <td style="white-space:nowrap;color:#374151;">@p.PaymentDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                            <td style="text-align:right;font-weight:700;color:#0f172a;">$@p.Amount.ToString("N2")</td>
                            <td><span class="tp-method">@p.Method</span></td>
                            <td><span class="tp-status-@statusCss">@statusLabel</span></td>
                            <td style="color:#4b5563;font-size:.83rem;">Dr. @p.Doctor.FirstName @p.Doctor.LastName</td>
                            <td style="color:#9ca3af;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@p.Notes">
                                @(p.Notes ?? "—")
                            </td>
                            @if (isManager)
                            {
                                <td style="text-align:right;white-space:nowrap;">
                                    <button class="btn-ghost btn-sm"
                                            onclick="openEditModal(@p.Id, @p.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @((int)p.Method), @((int)p.Status), '@p.PaymentDate.ToLocalTime().ToString("yyyy-MM-dd")', '@(p.Notes?.Replace("'","\\'")??"")' )">
                                        Edit
                                    </button>
                                    <form asp-action="DeleteInstallment" method="post" style="display:inline;"
                                          onsubmit="return confirm('Delete this payment record?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="treatmentId" value="@Model.Treatment.Id" />
                                        <button type="submit" class="btn-ghost btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:#f9fafb;">
                        <td colspan="2" style="padding:11px 16px;font-weight:600;font-size:.82rem;color:#374151;">Total paid</td>
                        <td style="text-align:right;padding:11px 16px;font-weight:700;color:#059669;">$@Model.TotalPaid.ToString("N2")</td>
                        <td colspan="@(isManager ? 5 : 4)"></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@if (isManager)
{
    <!-- Add Payment Modal -->
    <div id="addModal" class="tp-modal-overlay" style="display:none;">
        <div class="tp-modal">
            <div class="tp-modal-header">
                <h2 class="tp-modal-title">Add Payment</h2>
                <button class="tp-modal-close" onclick="closeAddModal()">&times;</button>
            </div>
            <form asp-action="AddInstallment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TreatmentId" value="@Model.Treatment.Id" />
                <input type="hidden" name="PatientId" value="@Model.Patient.Id" />
                <div class="tp-modal-body">
                    <div class="tp-form-group">
                        <label class="tp-form-label">Doctor *</label>
                        <select name="DoctorId" class="tp-form-select" required>
                            @foreach (var d in Model.Doctors)
                            {
                                if (d.Value == Model.Treatment.DoctorId.ToString())
                                {
                                    <option value="@d.Value" selected>@d.Text</option>
                                }
                                else
                                {
                                    <option value="@d.Value">@d.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="tp-form-row">
                        <div class="tp-form-group">
                            <label class="tp-form-label">Amount ($) *</label>
                            <input type="number" name="Amount" id="addAmount" class="tp-form-input"
                                   step="0.01" min="0.01" max="@Model.Remaining.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                   required oninput="updateRemainingHint(this.value)" />
                            <div class="tp-remaining-hint" id="remainingHint">
                                Remaining balance: <strong>$@Model.Remaining.ToString("N2")</strong>
                            </div>
                        </div>
                        <div class="tp-form-group">
                            <label class="tp-form-label">Payment Date *</label>
                            <input type="date" name="PaymentDate" class="tp-form-input"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="tp-form-row">
                        <div class="tp-form-group">
                            <label class="tp-form-label">Method *</label>
                            <select name="Method" class="tp-form-select" required>
                                @foreach (PaymentMethod m in Enum.GetValues(typeof(PaymentMethod)))
                                {
                                    <option value="@((int)m)">@m</option>
                                }
                            </select>
                        </div>
                        <div class="tp-form-group">
                            <label class="tp-form-label">Status *</label>
                            <select name="Status" class="tp-form-select" required>
                                @foreach (PaymentStatus s in Enum.GetValues(typeof(PaymentStatus)))
                                {
                                    if (s == PaymentStatus.Paid)
                                    {
                                        <option value="@((int)s)" selected>@s</option>
                                    }
                                    else
                                    {
                                        <option value="@((int)s)">@s</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="tp-form-group">
                        <label class="tp-form-label">Notes</label>
                        <textarea name="Notes" class="tp-form-textarea" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </div>
                <div class="tp-modal-footer">
                    <button type="button" class="btn-ghost" onclick="closeAddModal()">Cancel</button>
                    <button type="submit" class="btn-primary">Save Payment</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit Payment Modal -->
    <div id="editModal" class="tp-modal-overlay" style="display:none;">
        <div class="tp-modal">
            <div class="tp-modal-header">
                <h2 class="tp-modal-title">Edit Payment</h2>
                <button class="tp-modal-close" onclick="closeEditModal()">&times;</button>
            </div>
            <form asp-action="EditInstallment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <input type="hidden" name="treatmentId" value="@Model.Treatment.Id" />
                <div class="tp-modal-body">
                    <div class="tp-form-row">
                        <div class="tp-form-group">
                            <label class="tp-form-label">Amount ($) *</label>
                            <input type="number" name="amount" id="editAmount" class="tp-form-input" step="0.01" min="0.01" required />
                        </div>
                        <div class="tp-form-group">
                            <label class="tp-form-label">Payment Date *</label>
                            <input type="date" name="paymentDate" id="editDate" class="tp-form-input" required />
                        </div>
                    </div>
                    <div class="tp-form-row">
                        <div class="tp-form-group">
                            <label class="tp-form-label">Method *</label>
                            <select name="method" id="editMethod" class="tp-form-select" required>
                                @foreach (PaymentMethod m in Enum.GetValues(typeof(PaymentMethod)))
                                {
                                    <option value="@((int)m)">@m</option>
                                }
                            </select>
                        </div>
                        <div class="tp-form-group">
                            <label class="tp-form-label">Status *</label>
                            <select name="status" id="editStatus" class="tp-form-select" required>
                                @foreach (PaymentStatus s in Enum.GetValues(typeof(PaymentStatus)))
                                {
                                    <option value="@((int)s)">@s</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="tp-form-group">
                        <label class="tp-form-label">Notes</label>
                        <textarea name="notes" id="editNotes" class="tp-form-textarea" rows="2"></textarea>
                    </div>
                </div>
                <div class="tp-modal-footer">
                    <button type="button" class="btn-ghost" onclick="closeEditModal()">Cancel</button>
                    <button type="submit" class="btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.pay-toast').forEach(t => {
            setTimeout(() => t.style.opacity = '0', 3500);
            setTimeout(() => t.remove(), 4000);
        });

        const remaining = @Model.Remaining.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

        function updateRemainingHint(val) {
            const hint = document.getElementById('remainingHint');
            const amt = parseFloat(val) || 0;
            const left = remaining - amt;
            if (amt > remaining + 0.01) {
                hint.className = 'tp-remaining-hint warn';
                hint.innerHTML = `Exceeds remaining balance by <strong>$${(amt - remaining).toFixed(2)}</strong>`;
            } else {
                hint.className = 'tp-remaining-hint';
                hint.innerHTML = `After this payment, remaining: <strong>$${Math.max(0, left).toFixed(2)}</strong>`;
            }
        }

        function openAddModal()  { document.getElementById('addModal').style.display  = 'flex'; }
        function closeAddModal() { document.getElementById('addModal').style.display  = 'none'; }
        function openEditModal(id, amount, method, status, date, notes) {
            document.getElementById('editId').value     = id;
            document.getElementById('editAmount').value = amount;
            document.getElementById('editMethod').value = method;
            document.getElementById('editStatus').value = status;
            document.getElementById('editDate').value   = date;
            document.getElementById('editNotes').value  = notes;
            document.getElementById('editModal').style.display = 'flex';
        }
        function closeEditModal() { document.getElementById('editModal').style.display = 'none'; }

        document.addEventListener('click', e => {
            if (e.target.id === 'addModal')  closeAddModal();
            if (e.target.id === 'editModal') closeEditModal();
        });
    </script>
}
