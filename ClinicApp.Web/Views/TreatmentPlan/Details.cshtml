@using ClinicApp.Web.ViewModels
@using ClinicApp.Web.Models
@model TreatmentPlanDetailsViewModel

@using System.Security.Claims
@{
    var userRole = User.FindFirstValue(ClaimTypes.Role);
    Layout = userRole == "Doctor" ? "_DoctorLayout" : "_ManagerLayout";
    ViewData["Title"] = Model.Plan.Title;
}

<link rel="stylesheet" href="~/css/treatment-plan.css" />

<div class="treatment-plan-details-page">

    <!-- Header -->
    <header class="treatment-plan-header">
        <div class="treatment-plan-header-left">
            <a asp-action="Index" asp-route-id="@Model.Plan.PatientId" class="btn-back">
                ← Back to Plans
            </a>
            <div class="treatment-plan-header-text">
                <h1 class="treatment-plan-title">@Model.Plan.Title</h1>
                <p class="treatment-plan-subtitle">
                    @Model.Plan.Patient.FirstName @Model.Plan.Patient.LastName • 
                    Dr. @Model.Plan.Doctor.FirstName @Model.Plan.Doctor.LastName •
                    Created @Model.Plan.CreatedAt.ToString("MMM dd, yyyy")
                </p>
            </div>
        </div>
        
        <div class="plan-header-actions">
            @{
                var statusClass = Model.Plan.Status switch
                {
                    PlanStatus.Draft => "status-draft",
                    PlanStatus.Active => "status-active",
                    PlanStatus.Completed => "status-completed",
                    PlanStatus.Cancelled => "status-cancelled",
                    _ => "status-draft"
                };

                var statusText = Model.Plan.Status switch
                {
                    PlanStatus.Draft => "Draft",
                    PlanStatus.Active => "Active",
                    PlanStatus.Completed => "Completed",
                    PlanStatus.Cancelled => "Cancelled",
                    _ => "Draft"
                };
            }
            
            <span class="plan-status @statusClass">@statusText</span>
        </div>
    </header>

    <!-- Description -->
    @if (!string.IsNullOrEmpty(Model.Plan.Description))
    {
        <div class="plan-description-card">
            <p>@Model.Plan.Description</p>
        </div>
    }

    <!-- Progress Card -->
    <div class="progress-card">
        <div class="progress-stats">
            <div class="progress-stat">
                <span class="progress-stat-label">Treatments</span>
                <span class="progress-stat-value">@Model.CompletedTreatments / @Model.TotalTreatments</span>
            </div>
            <div class="progress-stat">
                <span class="progress-stat-label">Estimated Cost</span>
                <span class="progress-stat-value">$@Model.Plan.TotalEstimatedCost.ToString("N2")</span>
            </div>
            <div class="progress-stat">
                <span class="progress-stat-label">Actual Cost</span>
                <span class="progress-stat-value">$@Model.TotalActualCost.ToString("N2")</span>
            </div>
        </div>
        
        <div class="progress-bar-container">
            <div class="progress-bar-label">
                <span>Progress</span>
                <span>@Model.ProgressPercentage%</span>
            </div>
            <div class="progress-bar">
                <div class="progress-bar-fill" style="width: @Model.ProgressPercentage%"></div>
            </div>
        </div>
    </div>

    <!-- Treatments Section -->
    <section class="treatments-section">
        <div class="treatments-header">
            <h2 class="treatments-title">Treatments (@Model.Plan.Treatments.Count)</h2>
            <button class="btn-primary" onclick="openAddTreatmentModal()">
                + Add Treatment
            </button>
        </div>

        @if (Model.Plan.Treatments.Any())
        {
            <div class="treatments-list">
                @foreach (var treatment in Model.Plan.Treatments.OrderBy(t => t.Priority).ThenBy(t => t.ToothNumber))
                {
                    var treatmentStatusClass = treatment.Status switch
                    {
                        TreatmentStatus.Planned => "treatment-planned",
                        TreatmentStatus.InProgress => "treatment-inprogress",
                        TreatmentStatus.Completed => "treatment-completed",
                        TreatmentStatus.Cancelled => "treatment-cancelled",
                        _ => "treatment-planned"
                    };

                    var statusIcon = treatment.Status switch
                    {
                        TreatmentStatus.Planned => "📋",
                        TreatmentStatus.InProgress => "⏳",
                        TreatmentStatus.Completed => "✓",
                        TreatmentStatus.Cancelled => "✕",
                        _ => "📋"
                    };

                    var priorityClass = treatment.Priority switch
                    {
                        1 => "priority-urgent",
                        2 => "priority-medium",
                        3 => "priority-low",
                        _ => "priority-medium"
                    };

                    <div class="treatment-card @treatmentStatusClass">
                        <div class="treatment-card-header">
                            <div class="treatment-card-title-section">
                                <span class="treatment-status-icon">@statusIcon</span>
                                <h3 class="treatment-card-title">@treatment.Title</h3>
                                @if (treatment.ToothNumber.HasValue)
                                {
                                    <span class="treatment-tooth-badge">Tooth @treatment.ToothNumber</span>
                                }
                            </div>
                            <span class="treatment-priority @priorityClass">
                                @(treatment.Priority == 1 ? "Urgent" : treatment.Priority == 2 ? "Medium" : "Low")
                            </span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(treatment.Description))
                        {
                            <p class="treatment-description">@treatment.Description</p>
                        }
                        
                        <div class="treatment-info">
                            <div class="treatment-info-item">
                                <span class="treatment-info-label">Type:</span>
                                <span class="treatment-info-value">@treatment.Type.ToString()</span>
                            </div>
                            <div class="treatment-info-item">
                                <span class="treatment-info-label">Estimated:</span>
                                <span class="treatment-info-value">
                                    $@(treatment.EstimatedCost?.ToString("N2") ?? "0.00")
                                </span>
                            </div>
                            @if (treatment.Status == TreatmentStatus.Completed)
                            {
                                <div class="treatment-info-item">
                                    <span class="treatment-info-label">Actual:</span>
                                    <span class="treatment-info-value">$@treatment.Cost.ToString("N2")</span>
                                </div>
                            }
                        </div>

                        @* صور قبل / بعد إن وجدت *@
                        @if (!string.IsNullOrEmpty(treatment.BeforeImageUrl) || !string.IsNullOrEmpty(treatment.AfterImageUrl))
                        {
                            <div class="treatment-photos">
                                @if (!string.IsNullOrEmpty(treatment.BeforeImageUrl))
                                {
                                    <div class="treatment-photo">
                                        <span class="treatment-info-label">Before</span>
                                        <img src="@treatment.BeforeImageUrl"
                                             alt="Before photo"
                                             style="width:80px;height:80px;object-fit:cover;border-radius:8px;" />
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(treatment.AfterImageUrl))
                                {
                                    <div class="treatment-photo">
                                        <span class="treatment-info-label">After</span>
                                        <img src="@treatment.AfterImageUrl"
                                             alt="After photo"
                                             style="width:80px;height:80px;object-fit:cover;border-radius:8px;" />
                                    </div>
                                }
                            </div>
                        }
                        
                        <div class="treatment-actions">
                            @if (treatment.Status != TreatmentStatus.Completed && treatment.Status != TreatmentStatus.Cancelled)
                            {
                                <button class="btn-sm btn-primary"
                                        onclick="openUpdateTreatmentModal(@treatment.Id, '@treatment.Status', @treatment.Cost)">
                                    Update Status
                                </button>
                            }
                            <form asp-action="DeleteTreatment"
                                  method="post"
                                  style="display:inline;"
                                  onsubmit="return confirm('Are you sure?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="treatmentId" value="@treatment.Id" />
                                <button type="submit" class="btn-sm btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">🦷</div>
                <h3 class="empty-state-title">No Treatments Yet</h3>
                <p class="empty-state-text">Add treatments to this plan to get started.</p>
            </div>
        }
    </section>

    <!-- Add Treatment Modal -->
    <div id="addTreatmentModal" class="modal-overlay hidden">
        <div class="modal-card">
            <div class="modal-header">
                <h3 class="modal-title">Add Treatment</h3>
                <button class="modal-close" onclick="closeAddTreatmentModal()">&times;</button>
            </div>
            
            <form asp-action="AddTreatment" method="post" class="modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" name="planId" value="@Model.Plan.Id" />
                
                <div class="form-field">
                    <label class="form-label">Tooth Number (Optional)</label>
                    <input class="form-input" name="toothNumber" type="number" min="11" max="48" placeholder="e.g., 36" />
                </div>
                
                <div class="form-field">
                    <label class="form-label">Treatment Type *</label>
                    <select class="form-input" name="type" required>
                        <option value="1">Cleaning</option>
                        <option value="2">Filling</option>
                        <option value="3">Root Canal</option>
                        <option value="4">Extraction</option>
                        <option value="5">Crown</option>
                        <option value="6">Bridge</option>
                        <option value="7">Implant</option>
                        <option value="8">Whitening</option>
                        <option value="9">Orthodontics</option>
                        <option value="10">Denture</option>
                        <option value="11">Scaling</option>
                        <option value="12">Other</option>
                    </select>
                </div>
                
                <div class="form-field">
                    <label class="form-label">Title *</label>
                    <input class="form-input" name="title" required placeholder="e.g., Filling - Tooth 36" />
                </div>
                
                <div class="form-field">
                    <label class="form-label">Description</label>
                    <textarea class="form-textarea" name="description" rows="3"></textarea>
                </div>
                
                <div class="form-field">
                    <label class="form-label">Estimated Cost *</label>
                    <input class="form-input" name="estimatedCost" type="number" step="0.01" required placeholder="0.00" />
                </div>
                
                <div class="form-field">
                    <label class="form-label">Priority *</label>
                    <select class="form-input" name="priority" required>
                        <option value="1">Urgent</option>
                        <option value="2" selected>Medium</option>
                        <option value="3">Low</option>
                    </select>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn-primary">Add Treatment</button>
                    <button type="button" class="btn-ghost" onclick="closeAddTreatmentModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Update Treatment Modal -->
    <div id="updateTreatmentModal" class="modal-overlay hidden">
        <div class="modal-card">
            <div class="modal-header">
                <h3 class="modal-title">Update Treatment</h3>
                <button class="modal-close" onclick="closeUpdateTreatmentModal()">&times;</button>
            </div>
            
            <form asp-action="UpdateTreatment"
                  method="post"
                  enctype="multipart/form-data"
                  class="modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" id="update-treatment-id" name="treatmentId" />
                
                <div class="form-field">
                    <label class="form-label">Status *</label>
                    <select class="form-input" id="update-status" name="status" required>
                        <option value="1">Planned</option>
                        <option value="2">In Progress</option>
                        <option value="3">Completed</option>
                        <option value="4">Cancelled</option>
                    </select>
                </div>
                
                <div class="form-field">
                    <label class="form-label">Actual Cost</label>
                    <input class="form-input" id="update-cost" name="actualCost" type="number" step="0.01" placeholder="0.00" />
                </div>
                
                <div class="form-field">
                    <label class="form-label">Notes</label>
                    <textarea class="form-textarea" name="notes" rows="3"></textarea>
                </div>

                <div class="form-field">
                    <label class="form-label">Before Photo</label>
                    <input class="form-input"
                           type="file"
                           name="beforeImageFile"
                           accept="image/*" />
                </div>

                <div class="form-field">
                    <label class="form-label">After Photo</label>
                    <input class="form-input"
                           type="file"
                           name="afterImageFile"
                           accept="image/*" />
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn-primary">Update</button>
                    <button type="button" class="btn-ghost" onclick="closeUpdateTreatmentModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function openAddTreatmentModal() {
            document.getElementById('addTreatmentModal').classList.remove('hidden');
        }

        function closeAddTreatmentModal() {
            document.getElementById('addTreatmentModal').classList.add('hidden');
        }

        function openUpdateTreatmentModal(id, status, cost) {
            document.getElementById('update-treatment-id').value = id;
            document.getElementById('update-status').value = status;
            document.getElementById('update-cost').value = cost;
            document.getElementById('updateTreatmentModal').classList.remove('hidden');
        }

        function closeUpdateTreatmentModal() {
            document.getElementById('updateTreatmentModal').classList.add('hidden');
        }
    </script>
}
