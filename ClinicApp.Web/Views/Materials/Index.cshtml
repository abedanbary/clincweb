@using ClinicApp.Web.ViewModels
@using ClinicApp.Web.Models
@model MaterialsPageViewModel

@{
    Layout = User.IsInRole("Doctor") ? "_DoctorLayout" : "_ManagerLayout";
    ViewData["Title"] = "Materials";
    var isManager = User.IsInRole("Manager");
}

<div class="materials-page">

    <!-- Header -->
    <header class="materials-header">
        <div class="materials-header-text">
            <h1 class="materials-title">Materials</h1>
            <p class="materials-subtitle">
                Manage clinic supplies such as gloves, masks, disinfectants and other consumables.
            </p>
        </div>

        <div class="materials-header-actions">
            <a href="/Materials/Invoices" class="btn-ghost" style="text-decoration: none;">
                🧾 Purchase Invoices
            </a>
            @if (isManager)
            {
                <a href="/Materials/ExportExcel" class="btn-ghost" style="text-decoration: none;">
                   📊 Export to Excel
                </a>
                <button class="btn-primary" onclick="openAddMaterialModal()">
                    Add Material
                </button>
            }
        </div>
    </header>

    <!-- Main: table only -->
    <section class="materials-grid">
        <div class="materials-card materials-table-card" style="grid-column: 1 / -1;">
            <div class="materials-card-header">
                <div>
                    <h2 class="materials-card-title">Current Stock</h2>
                    <p class="materials-card-caption">All materials in your clinic</p>
                </div>
                <div class="materials-card-extra">
                    <select class="materials-filter">
                        <option>All status</option>
                        <option>OK</option>
                        <option>Low</option>
                    </select>
                </div>
            </div>

            <div class="materials-table-wrapper">
                <table class="materials-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;"></th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Unit</th>
                            <th>Quantity</th>
                            <th>Minimum limit</th>
                            <th>Status</th>
                            <th style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Materials.Any())
                        {
                            foreach (var item in Model.Materials)
                            {
                                var isLow = item.Quantity <= item.MinimumLimit;
                                <tr>
                                    <td>
                                       <button class="btn-history" type="button" onclick="toggleHistory(@item.Id, this)" aria-expanded="false">
                                       <span class="btn-history-icon">▶</span>
                                       </button>
                                    </td>
                                    <td>@item.Name</td>
                                    <td>@item.Description</td>
                                    <td>@item.Unit</td>
                                    <td>
                                        <strong>@item.Quantity</strong>
                                    </td>
                                    <td>@item.MinimumLimit</td>
                                    <td>
                                        @if (isLow)
                                        {
                                            <span class="badge badge-warning">Low</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-ok">OK</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn-ghost btn-sm" onclick="openEditQuantityModal(@item.Id, '@item.Name', @item.Quantity)">+/-</button>
                                        @if (isManager)
                                        {
                                            <button class="btn-ghost btn-sm" onclick="editMaterial(@item.Id)">Edit</button>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline;" onsubmit="return confirm('Delete this material?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-ghost btn-danger btn-sm">Remove</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                                 <tr id="history-@item.Id" class="materials-history-row" style="display: none;">
                                    <td colspan="8">
                                      <div class="history-inner">
                                       <div class="history-loading">Loading history...</div>
                                       <div class="history-content" style="display: none;"></div>
                                      </div>
                                     </td>
                                 </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">No materials found for this clinic yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@if (isManager)
{
<!-- Modal: Add Material -->
<div id="addMaterialModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeAddMaterialModal()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h2>Add New Material</h2>
            <button class="modal-close" onclick="closeAddMaterialModal()">&times;</button>
        </div>

        <form asp-action="Add" asp-controller="Materials" method="post" enctype="multipart/form-data" class="materials-form">
            @Html.AntiForgeryToken()

            <div class="materials-field">
                <label class="materials-label" asp-for="NewMaterial.Name"></label>
                <input class="materials-input" asp-for="NewMaterial.Name" required />
                <span class="materials-error" asp-validation-for="NewMaterial.Name"></span>
            </div>

            <div class="materials-field">
                <label class="materials-label" asp-for="NewMaterial.Description"></label>
                <textarea class="materials-textarea" asp-for="NewMaterial.Description" rows="3"></textarea>
            </div>

            <div class="materials-field-row">
                <div class="materials-field">
                    <label class="materials-label" asp-for="NewMaterial.Unit"></label>
                    <select class="materials-select" asp-for="NewMaterial.Unit" required>
                        <option value="">Select unit</option>
                        <option>Box</option>
                        <option>Unit</option>
                        <option>Liter</option>
                        <option>ml</option>
                        <option>Pack</option>
                    </select>
                </div>

                <div class="materials-field">
                    <label class="materials-label" asp-for="NewMaterial.Quantity"></label>
                    <input class="materials-input" asp-for="NewMaterial.Quantity" type="number" min="0" required id="addQty" oninput="updateAddTotal()" />
                </div>
            </div>

            <div class="materials-field">
                <label class="materials-label" asp-for="NewMaterial.MinimumLimit"></label>
                <input class="materials-input" asp-for="NewMaterial.MinimumLimit" type="number" min="0" required />
            </div>

            <div class="materials-field">
                <label class="materials-label">Supplier</label>
                <input class="materials-input" asp-for="NewMaterial.Supplier" placeholder="Supplier name" />
            </div>

            <!-- Purchase Invoice toggle -->
            <div style="border-top: 1px solid #e5e7eb; margin-top: .5rem; padding-top: .75rem;">
                <label style="display:flex; align-items:center; gap:.5rem; cursor:pointer; font-size:.875rem; font-weight:500; color:#374151;">
                    <input type="checkbox" asp-for="Invoice.CreateInvoice" id="addCreateInvoice" onchange="toggleAddInvoice(this)" style="width:16px;height:16px;accent-color:#10b981;" />
                    Create a purchase invoice for this stock
                </label>
            </div>

            <div id="addInvoiceFields" style="display:none; margin-top:.75rem; padding:.9rem; background:#f0fdf4; border-radius:8px; border:1px solid #bbf7d0;">
                <div style="font-size:.78rem; font-weight:600; color:#059669; margin-bottom:.65rem; text-transform:uppercase; letter-spacing:.05em;">Purchase Invoice</div>
                <div class="materials-field-row">
                    <div class="materials-field">
                        <label class="materials-label">Unit Price</label>
                        <input class="materials-input" asp-for="Invoice.UnitPrice" type="number" min="0.01" step="0.01" placeholder="0.00" id="addUnitPrice" oninput="updateAddTotal()" />
                    </div>
                    <div class="materials-field">
                        <label class="materials-label">Payment Method</label>
                        <select class="materials-select" asp-for="Invoice.PaymentMethod">
                            <option value="1">Cash</option>
                            <option value="2">Credit Card</option>
                            <option value="3">Bank Transfer</option>
                        </select>
                    </div>
                </div>
                <div class="materials-field">
                    <label class="materials-label">Invoice Notes (optional)</label>
                    <input class="materials-input" asp-for="Invoice.Notes" placeholder="e.g. Batch #123, net 30..." />
                </div>
                <div class="materials-field">
                    <label class="materials-label">Invoice Image (optional)</label>
                    <input type="file" name="invoiceImage" class="materials-input"
                           accept=".jpg,.jpeg,.png,.pdf,.webp"
                           style="padding:.4rem .5rem;" />
                    <small style="color:#9ca3af;font-size:.72rem;">Photo or scan of the paper invoice</small>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; font-size:.85rem; color:#374151; padding:.4rem 0 0;">
                    <span>Total Amount</span>
                    <strong id="addTotalDisplay" style="color:#059669; font-size:1rem;">—</strong>
                </div>
            </div>

            <div class="materials-form-actions">
                <button type="submit" class="btn-primary">Save Material</button>
                <button type="button" class="btn-ghost" onclick="closeAddMaterialModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>
}

<!-- Modal: Edit Quantity (+/-) -->
<div id="editQuantityModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeEditQuantityModal()"></div>
    <div class="modal-content modal-sm">
        <div class="modal-header">
            <h2>Update Quantity</h2>
            <button class="modal-close" onclick="closeEditQuantityModal()">&times;</button>
        </div>

        <form asp-action="UpdateQuantity" method="post" enctype="multipart/form-data" id="updateQuantityForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editMaterialId" />

            <div class="materials-field">
                <label class="materials-label">Material</label>
                <input type="text" class="materials-input" id="editMaterialName" readonly />
            </div>

            <div class="materials-field">
                <label class="materials-label">Current Quantity</label>
                <input type="text" class="materials-input" id="editCurrentQuantity" readonly />
            </div>

            <div class="materials-field">
                <label class="materials-label">Change (+/-)</label>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <button type="button" class="btn-ghost" onclick="adjustQuantityChange(-10)">-10</button>
                    <button type="button" class="btn-ghost" onclick="adjustQuantityChange(-1)">-1</button>
                    <input type="number" class="materials-input" name="change" id="quantityChange" value="0" style="text-align: center; flex: 1;" oninput="onQtyChangeInput()" />
                    <button type="button" class="btn-ghost" onclick="adjustQuantityChange(1)">+1</button>
                    <button type="button" class="btn-ghost" onclick="adjustQuantityChange(10)">+10</button>
                </div>
            </div>

            <div class="materials-field">
                <label class="materials-label">Note (optional)</label>
                <input type="text" class="materials-input" name="note" placeholder="e.g., Received shipment" />
            </div>

            <!-- Purchase Invoice toggle -->
            <div id="invoiceToggleWrapper" style="border-top: 1px solid #e5e7eb; margin-top: .5rem; padding-top: .75rem; display:none;">
                <label style="display:flex; align-items:center; gap:.5rem; cursor:pointer; font-size:.875rem; font-weight:500; color:#374151;">
                    <input type="checkbox" name="createInvoice" id="editCreateInvoice" onchange="toggleEditInvoice(this)" style="width:16px;height:16px;accent-color:#10b981;" />
                    Create a purchase invoice for this stock
                </label>
            </div>

            <div id="editInvoiceFields" style="display:none; margin-top:.75rem; padding:.9rem; background:#f0fdf4; border-radius:8px; border:1px solid #bbf7d0;">
                <div style="font-size:.78rem; font-weight:600; color:#059669; margin-bottom:.65rem; text-transform:uppercase; letter-spacing:.05em;">Purchase Invoice</div>
                <div class="materials-field-row">
                    <div class="materials-field">
                        <label class="materials-label">Unit Price</label>
                        <input class="materials-input" name="unitPrice" type="number" min="0.01" step="0.01" placeholder="0.00" id="editUnitPrice" oninput="updateEditTotal()" />
                    </div>
                    <div class="materials-field">
                        <label class="materials-label">Payment Method</label>
                        <select class="materials-select" name="paymentMethod">
                            <option value="1">Cash</option>
                            <option value="2">Credit Card</option>
                            <option value="3">Bank Transfer</option>
                        </select>
                    </div>
                </div>
                <div class="materials-field">
                    <label class="materials-label">Invoice Notes (optional)</label>
                    <input class="materials-input" name="invoiceNotes" placeholder="e.g. Batch #123, net 30..." />
                </div>
                <div class="materials-field">
                    <label class="materials-label">Invoice Image (optional)</label>
                    <input type="file" name="invoiceImage" class="materials-input"
                           accept=".jpg,.jpeg,.png,.pdf,.webp"
                           style="padding:.4rem .5rem;" />
                    <small style="color:#9ca3af;font-size:.72rem;">Photo or scan of the paper invoice</small>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; font-size:.85rem; color:#374151; padding:.4rem 0 0;">
                    <span>Total Amount</span>
                    <strong id="editTotalDisplay" style="color:#059669; font-size:1rem;">—</strong>
                </div>
            </div>

            <div class="materials-form-actions">
                <button type="submit" class="btn-primary">Save Change</button>
                <button type="button" class="btn-ghost" onclick="closeEditQuantityModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
    // ===== Add Material Modal =====
    function openAddMaterialModal() {
        document.getElementById('addMaterialModal').style.display = 'flex';
    }
    function closeAddMaterialModal() {
        document.getElementById('addMaterialModal').style.display = 'none';
    }

    function toggleAddInvoice(cb) {
        document.getElementById('addInvoiceFields').style.display = cb.checked ? 'block' : 'none';
    }

    function updateAddTotal() {
        const qty = parseFloat(document.getElementById('addQty')?.value) || 0;
        const price = parseFloat(document.getElementById('addUnitPrice')?.value) || 0;
        const total = qty * price;
        document.getElementById('addTotalDisplay').textContent = total > 0 ? total.toFixed(2) : '—';
    }

    // ===== Edit Quantity Modal =====
    function openEditQuantityModal(id, name, currentQty) {
        document.getElementById('editMaterialId').value = id;
        document.getElementById('editMaterialName').value = name;
        document.getElementById('editCurrentQuantity').value = currentQty;
        document.getElementById('quantityChange').value = 0;
        document.getElementById('invoiceToggleWrapper').style.display = 'none';
        document.getElementById('editInvoiceFields').style.display = 'none';
        if (document.getElementById('editCreateInvoice')) document.getElementById('editCreateInvoice').checked = false;
        document.getElementById('editQuantityModal').style.display = 'flex';
    }
    function closeEditQuantityModal() {
        document.getElementById('editQuantityModal').style.display = 'none';
    }

    function adjustQuantityChange(amount) {
        const input = document.getElementById('quantityChange');
        input.value = parseInt(input.value || 0) + amount;
        onQtyChangeInput();
    }

    function onQtyChangeInput() {
        const change = parseInt(document.getElementById('quantityChange').value) || 0;
        // Only show invoice toggle for positive (purchasing) changes
        document.getElementById('invoiceToggleWrapper').style.display = change > 0 ? 'block' : 'none';
        if (change <= 0) {
            document.getElementById('editInvoiceFields').style.display = 'none';
            if (document.getElementById('editCreateInvoice')) document.getElementById('editCreateInvoice').checked = false;
        }
        updateEditTotal();
    }

    function toggleEditInvoice(cb) {
        document.getElementById('editInvoiceFields').style.display = cb.checked ? 'block' : 'none';
    }

    function updateEditTotal() {
        const qty = Math.max(0, parseInt(document.getElementById('quantityChange')?.value) || 0);
        const price = parseFloat(document.getElementById('editUnitPrice')?.value) || 0;
        const total = qty * price;
        const el = document.getElementById('editTotalDisplay');
        if (el) el.textContent = total > 0 ? total.toFixed(2) : '—';
    }

    // ===== History Toggle =====
    async function toggleHistory(materialId, buttonEl) {
        const historyRow = document.getElementById('history-' + materialId);
        const isHidden = historyRow.style.display === 'none' || historyRow.style.display === '';

        if (isHidden) {
            historyRow.style.display = 'table-row';
            buttonEl.setAttribute('aria-expanded', 'true');

            const loadingDiv = historyRow.querySelector('.history-loading');
            const contentDiv = historyRow.querySelector('.history-content');

            if (contentDiv.innerHTML.trim() === '') {
                try {
                    const response = await fetch('/Materials/History/' + materialId);
                    const history = await response.json();

                    loadingDiv.style.display = 'none';
                    contentDiv.style.display = 'block';

                    if (history.length === 0) {
                        contentDiv.innerHTML = '<p>No history found.</p>';
                    } else {
                        let html = '<table>';
                        html += '<thead><tr><th>Date</th><th>Change</th><th>New Qty</th><th>Note</th><th>Invoice</th></tr></thead><tbody>';

                        history.forEach(h => {
                            const date = new Date(h.createdAt || h.CreatedAt).toLocaleString();
                            const changeColor = h.quantityChange > 0 ? 'green' : 'red';
                            const changeSign = h.quantityChange > 0 ? '+' : '';

                            let invoiceCell = '<span style="color:#9ca3af;">—</span>';
                            if (h.invoiceId) {
                                invoiceCell = `<a href="/Materials/Invoices" style="color:#10b981;font-weight:500;font-size:.78rem;text-decoration:none;"
                                    title="Total: ${h.invoiceTotal?.toFixed(2)}">
                                    🧾 ${h.invoiceNumber}
                                </a>`;
                            }

                            html += `<tr>
                                <td>${date}</td>
                                <td style="color:${changeColor};">${changeSign}${h.quantityChange}</td>
                                <td><strong>${h.newQuantity}</strong></td>
                                <td>${h.note || '-'}</td>
                                <td>${invoiceCell}</td>
                            </tr>`;
                        });

                        html += '</tbody></table>';
                        contentDiv.innerHTML = html;
                    }
                } catch (error) {
                    loadingDiv.style.display = 'none';
                    contentDiv.style.display = 'block';
                    contentDiv.innerHTML = '<p style="color: #fca5a5;">Error loading history.</p>';
                }
            }
        } else {
            historyRow.style.display = 'none';
            buttonEl.setAttribute('aria-expanded', 'false');
        }
    }

    function editMaterial(id) {
        alert('Edit functionality coming soon for material ID: ' + id);
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeAddMaterialModal();
            closeEditQuantityModal();
        }
    });
    </script>
}
