@using ClinicApp.Web.ViewModels
@using ClinicApp.Web.Models
@model DoctorViewModel

@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <!-- Header -->
    <div class="dashboard-header">
        <div class="dashboard-header-text">
            <h1 class="dashboard-title">Welcome back, Dr. @Model.DoctorName</h1>
            <p class="dashboard-subtitle">@Model.ClinicName</p>
        </div>
        <p class="dashboard-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📅</div>
            <div>
                <div class="stat-label">Today's Appointments</div>
                <div class="stat-value">@Model.TodayAppointmentsCount</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div>
                <div class="stat-label">Total Patients</div>
                <div class="stat-value">@Model.TotalPatientsCount</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">⏰</div>
            <div>
                <div class="stat-label">Pending Appointments</div>
                <div class="stat-value">@Model.PendingAppointmentsCount</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">⚠️</div>
            <div>
                <div class="stat-label">Low Stock Items</div>
                <div class="stat-value">@Model.LowStockMaterialsCount</div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="content-grid">

        <!-- Today's Schedule -->
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <div>
                    <h2 class="dashboard-card-title">Today's Schedule</h2>
                    <p class="dashboard-card-caption">@Model.TodayAppointmentsCount appointment(s) today</p>
                </div>
                <a href="/Appointments" style="font-size:12px;color:var(--color-sky);text-decoration:none;font-weight:500;">View all</a>
            </div>

            <div class="appointments-list">
                @if (Model.TodayAppointments != null && Model.TodayAppointments.Any())
                {
                    foreach (var appointment in Model.TodayAppointments)
                    {
                        var statusClass = appointment.Status switch
                        {
                            AppointmentStatus.Completed => "status-completed",
                            AppointmentStatus.Cancelled => "status-cancelled",
                            AppointmentStatus.NoShow    => "status-noshow",
                            _                           => "status-pending"
                        };
                        <div class="appointment-item">
                            <div class="appointment-info">
                                <div class="appointment-patient">
                                    @appointment.Patient.FirstName @appointment.Patient.LastName
                                </div>
                                <div class="appointment-time">@appointment.StartTime.ToString("HH:mm")</div>
                            </div>
                            <span class="appointment-status @statusClass">@appointment.Status</span>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No appointments scheduled for today</div>
                }
            </div>
        </div>

        <!-- Sidebar -->
        <div style="display:flex;flex-direction:column;gap:16px;">

            <!-- Recent Patients -->
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <div>
                        <h2 class="dashboard-card-title">Recent Patients</h2>
                        <p class="dashboard-card-caption">Last registered</p>
                    </div>
                    <a href="/Patients" style="font-size:12px;color:var(--color-sky);text-decoration:none;font-weight:500;">View all</a>
                </div>
                <div class="patient-list">
                    @if (Model.RecentPatients.Any())
                    {
                        foreach (var patient in Model.RecentPatients)
                        {
                            var initials = $"{patient.FirstName[0]}{patient.LastName[0]}";
                            <div class="patient-item">
                                <div class="patient-avatar">@initials</div>
                                <div class="patient-details">
                                    <div class="patient-name">@patient.FirstName @patient.LastName</div>
                                    <div class="patient-phone">@patient.Phone</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">No patients yet</div>
                    }
                </div>
            </div>

            <!-- Low Stock -->
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <div>
                        <h2 class="dashboard-card-title">Low Stock Alert</h2>
                        <p class="dashboard-card-caption">Materials running low</p>
                    </div>
                    <a href="/Materials" style="font-size:12px;color:var(--color-sky);text-decoration:none;font-weight:500;">View all</a>
                </div>
                <div class="material-list">
                    @if (Model.LowStockMaterials.Any())
                    {
                        foreach (var material in Model.LowStockMaterials)
                        {
                            <div class="material-item">
                                <span class="material-name">@material.Name</span>
                                <span class="material-quantity">@material.Quantity @material.Unit</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">All materials are stocked</div>
                    }
                </div>
            </div>

        </div>
    </div>

</div>
