@model ClinicApp.Web.ViewModels.AppointmentsPageViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Appointments Calendar";
    var userRole = User.FindFirstValue(ClaimTypes.Role);
    Layout = userRole == "Doctor" ? "_DoctorLayout" : userRole == "Assistant" ? "_AssistantLayout" : "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/Calendar.css" />

<!-- Toast container -->
<div class="toast-container" id="toastContainer"></div>

<!-- ===============================================================
     Main Calendar Card
     =============================================================== -->
<div class="cal-root" id="calRoot">

    <!-- ── Toolbar ──────────────────────────────────────────── -->
    <div class="cal-toolbar">

        <div class="cal-nav-cluster">
            <button class="cal-nav-btn" id="prevBtn" aria-label="Previous">&#8249;</button>
            <button class="cal-today-btn" id="todayBtn">Today</button>
            <button class="cal-nav-btn" id="nextBtn" aria-label="Next">&#8250;</button>
            <span class="cal-period-label" id="periodLabel"></span>
        </div>

        <div class="cal-doctor-pills" id="doctorPills"></div>

        <div class="cal-view-group">
            <button class="cal-view-btn active" id="weekBtn">Week</button>
            <button class="cal-view-btn" id="dayBtn">Day</button>
        </div>

        <div class="cal-toolbar-actions">
            <button type="button" class="cal-ghost-btn" id="cancelledToggleBtn">Show Cancelled</button>
            <button type="button" class="cal-ghost-btn" onclick="printWeekPdf()">Print PDF</button>
            <button type="button" class="cal-ghost-btn" onclick="exportWeekExcel()">Export</button>
            <a asp-action="Index" class="cal-ghost-btn">Table View</a>
            <button type="button" class="cal-new-btn" id="openModalBtn">+ New Appointment</button>
        </div>

    </div>

    <!-- ── Main area ────────────────────────────────────────── -->
    <div class="cal-main">

        <!-- Day header row -->
        <div class="cal-day-header" id="dayHeader">
            <div class="cal-gutter-space"></div>
            <!-- Day cells injected by calendar.js -->
        </div>

        <!-- Scrollable time grid -->
        <div class="cal-grid-scroller" id="calGridScroller">
            <div class="cal-grid" id="calGrid">
                <!-- Time gutter + day columns injected by calendar.js -->
            </div>
        </div>

    </div>

    <!-- ── Slide-in detail panel ────────────────────────────── -->
    <div class="cal-detail-panel" id="detailPanel">
        <div class="cal-detail-header" id="detailHeader"></div>
        <div class="cal-detail-rows"   id="detailRows"></div>
        <div class="cal-detail-footer" id="detailFooter"></div>
    </div>

</div>

<!-- TempData alerts (below the calendar card) -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-top:12px;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error" style="margin-top:12px;">@TempData["Error"]</div>
}

<!-- ===============================================================
     Edit Appointment Modal
     =============================================================== -->
<div class="cal-modal-overlay" id="editModal">
    <div class="cal-modal-panel">

        <div class="cal-modal-header">
            <div class="cal-modal-header-content">
                <div class="cal-modal-header-icon">
                    <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                </div>
                <h2 class="cal-modal-title">Edit Appointment</h2>
            </div>
            <button type="button" class="cal-modal-close" id="closeEditBtn" aria-label="Close">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <div class="cal-modal-body">
            <form asp-action="Edit" method="post" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="EditId" name="Id" />

                <div class="cal-form-group">
                    <label class="cal-form-label">Patient</label>
                    <input type="text" id="EditPatientName" class="cal-form-input" readonly />
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Doctor</label>
                    <select id="EditDoctorId" name="DoctorId" asp-items="Model.Doctors" class="cal-form-select" required>
                        <option value="">— Select Doctor —</option>
                    </select>
                </div>

                <div class="cal-form-row">
                    <div class="cal-form-group">
                        <label class="cal-form-label">Start Time</label>
                        <input id="EditStartTime" name="StartTime" type="datetime-local" class="cal-form-input" required />
                    </div>
                    <div class="cal-form-group">
                        <label class="cal-form-label">End Time</label>
                        <input id="EditEndTime" name="EndTime" type="datetime-local" class="cal-form-input" required />
                    </div>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Status</label>
                    <select id="EditStatus" name="Status" class="cal-form-select" required>
                        <option value="1">Scheduled</option>
                        <option value="2">Completed</option>
                        <option value="3">Cancelled</option>
                        <option value="4">No Show</option>
                    </select>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Reason for Visit</label>
                    <textarea id="EditReasonForVisit" name="ReasonForVisit" class="cal-form-textarea" rows="2"></textarea>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Notes</label>
                    <textarea id="EditNotes" name="Notes" class="cal-form-textarea" rows="2"></textarea>
                </div>
            </form>
        </div>

        <div class="cal-modal-footer">
            <button type="button" class="cal-btn cal-btn-ghost" id="cancelEditBtn"
                    onclick="document.getElementById('editModal').classList.remove('active')">
                Cancel
            </button>
            <button type="submit" form="editForm" class="cal-btn cal-btn-primary">Save Changes</button>
        </div>

    </div>
</div>

<!-- ===============================================================
     Create Appointment Modal
     =============================================================== -->
<div class="cal-modal-overlay" id="appointmentModal">
    <div class="cal-create-panel" onclick="event.stopPropagation()">

        <div class="cal-modal-header">
            <div class="cal-modal-header-content">
                <div class="cal-modal-header-icon">
                    <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                    </svg>
                </div>
                <h2 class="cal-modal-title">New Appointment</h2>
            </div>
            <button type="button" class="cal-modal-close" id="closeModalBtn" aria-label="Close">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Scrollable body -->
        <div class="cal-modal-body">
            <form id="createForm" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="cal-patient-toggle">
                    <label class="cal-toggle-option">
                        <input type="radio" name="NewAppointment.IsNewPatient" value="false" checked id="existingPatientRadio" />
                        <span class="cal-toggle-pill">Existing Patient</span>
                    </label>
                    <label class="cal-toggle-option">
                        <input type="radio" name="NewAppointment.IsNewPatient" value="true" id="newPatientRadio" />
                        <span class="cal-toggle-pill">New Patient</span>
                    </label>
                </div>

                <div id="existing-patient-section">
                    <div class="cal-form-group">
                        <label class="cal-form-label">Patient</label>
                        <select asp-for="NewAppointment.ExistingPatientId" asp-items="Model.Patients"
                                class="cal-form-select" id="ExistingPatientId">
                            <option value="">— Select Patient —</option>
                        </select>
                        <span class="cal-doctor-note" id="patientConflictNote"></span>
                    </div>
                </div>

                <div id="new-patient-section" style="display:none;">
                    <div class="cal-section-heading">Patient Details</div>
                    <div class="cal-form-row">
                        <div class="cal-form-group">
                            <label class="cal-form-label">First Name *</label>
                            <input name="NewAppointment.NewPatientFirstName" class="cal-form-input" placeholder="First name" />
                        </div>
                        <div class="cal-form-group">
                            <label class="cal-form-label">Last Name *</label>
                            <input name="NewAppointment.NewPatientLastName" class="cal-form-input" placeholder="Last name" />
                        </div>
                    </div>
                    <div class="cal-form-row">
                        <div class="cal-form-group">
                            <label class="cal-form-label">Phone *</label>
                            <input name="NewAppointment.NewPatientPhone" class="cal-form-input" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="cal-form-group">
                            <label class="cal-form-label">Gender</label>
                            <select name="NewAppointment.NewPatientGender" class="cal-form-select">
                                <option value="">— Select —</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="cal-form-group">
                        <label class="cal-form-label">Date of Birth</label>
                        <input name="NewAppointment.NewPatientDateOfBirth" type="date" class="cal-form-input" />
                    </div>
                </div>

                <div class="cal-section-divider"></div>

                <!-- Hidden fields submitted to server -->
                <input type="hidden" name="NewAppointment.StartTime" id="StartTime" />
                <input type="hidden" name="NewAppointment.EndTime"   id="EndTime" />

                <div class="cal-form-row">
                    <div class="cal-form-group">
                        <label class="cal-form-label">Date</label>
                        <input type="date" class="cal-form-input" id="ApptDate" />
                    </div>
                    <div class="cal-form-group">
                        <label class="cal-form-label">Start Time</label>
                        <select class="cal-form-select" id="ApptTime">
                            <option value="">— Select time —</option>
                        </select>
                    </div>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Duration</label>
                    <div class="cal-duration-pills" id="durationPills">
                        <button type="button" class="cal-duration-pill" data-minutes="15">15 min</button>
                        <button type="button" class="cal-duration-pill active" data-minutes="30">30 min</button>
                        <button type="button" class="cal-duration-pill" data-minutes="45">45 min</button>
                        <button type="button" class="cal-duration-pill" data-minutes="60">1 hr</button>
                        <button type="button" class="cal-duration-pill" data-minutes="90">1.5 hr</button>
                        <button type="button" class="cal-duration-pill" data-minutes="120">2 hr</button>
                    </div>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Doctor</label>
                    @if (userRole == "Doctor")
                    {
                        var doctorFirst = User.FindFirstValue("FirstName") ?? "";
                        var doctorLast  = User.FindFirstValue("LastName")  ?? "";
                        var doctorId    = User.FindFirstValue("UserId")    ?? "";
                        <div class="cal-readonly-field">Dr. @doctorFirst @doctorLast</div>
                        <input type="hidden" name="NewAppointment.DoctorId" id="DoctorId" value="@doctorId" />
                    }
                    else
                    {
                        <select name="NewAppointment.DoctorId" class="cal-form-select" id="DoctorId">
                            <option value="">— Select time first —</option>
                        </select>
                    }
                    <span class="cal-doctor-note" id="doctorAvailabilityNote"></span>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Reason for Visit</label>
                    <textarea name="NewAppointment.ReasonForVisit" class="cal-form-textarea" rows="2"
                              placeholder="Brief description…"></textarea>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Notes</label>
                    <textarea name="NewAppointment.Notes" class="cal-form-textarea" rows="2"
                              placeholder="Additional notes…"></textarea>
                </div>
            </form>
        </div>

        <!-- Footer outside the form — submit button references form by id -->
        <div class="cal-modal-footer">
            <button type="button" class="cal-btn cal-btn-ghost" id="cancelModalBtn">Cancel</button>
            <button type="submit" form="createForm" class="cal-btn cal-btn-primary">Save Appointment</button>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        window.appEndpoints = {
            getAvailableDoctors:  '@Url.Action("GetAvailableDoctors",  "Appointments")',
            getAppointment:       '@Url.Action("GetAppointment",        "Appointments")',
            checkPatientConflict: '@Url.Action("CheckPatientConflict",  "Appointments")'
        };
        window.currentUser = {
            role: '@(userRole ?? "")',
            id:   '@(User.FindFirstValue("UserId") ?? "")',
            name: 'Dr. @(User.FindFirstValue("FirstName") ?? "") @(User.FindFirstValue("LastName") ?? "")'
        };
    </script>
    <script src="~/js/calendar.js"></script>
}
