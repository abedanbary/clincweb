@model ClinicApp.Web.ViewModels.AppointmentsPageViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Appointments Calendar";
    var userRole = User.FindFirstValue(ClaimTypes.Role);
    Layout = userRole == "Doctor" ? "_DoctorLayout" : "_ManagerLayout";
}

<link rel="stylesheet" href="~/css/Appointments.css" />
<link rel="stylesheet" href="~/css/Calendar.css" />

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<!-- Loading Overlay -->
<div class="cal-loading" id="calLoading">
    <div class="cal-loading-spinner"></div>
    <p class="cal-loading-text">Loading appointments…</p>
</div>

<div class="appointments-page">

    <!-- Header -->
    <header class="appointments-header">
        <div class="appointments-header-text">
            <h1 class="appointments-title">Appointments Calendar</h1>
            <p class="appointments-subtitle">Visual calendar view of all appointments</p>
        </div>
        <div class="cal-header-actions">
            <button type="button" class="cal-btn cal-btn-ghost" onclick="printWeekPdf()">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                </svg>
                Print PDF
            </button>
            <button type="button" class="cal-btn cal-btn-ghost" onclick="exportWeekExcel()">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                </svg>
                Export Excel
            </button>
            <a asp-action="Index" class="cal-btn cal-btn-ghost">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 10h18M3 14h18M3 6h18M3 18h18"/>
                </svg>
                Table View
            </a>
            <button type="button" class="cal-btn cal-btn-primary" id="openModalBtn">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
                New Appointment
            </button>
        </div>
    </header>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }

    <!-- Stats Bar -->
    <div class="cal-stats-bar">
        <div class="cal-stat">
            <div class="cal-stat-indicator scheduled"></div>
            <div>
                <div class="cal-stat-count" id="stat-scheduled">—</div>
                <div class="cal-stat-label">Scheduled</div>
            </div>
        </div>
        <div class="cal-stat">
            <div class="cal-stat-indicator completed"></div>
            <div>
                <div class="cal-stat-count" id="stat-completed">—</div>
                <div class="cal-stat-label">Completed</div>
            </div>
        </div>
        <div class="cal-stat">
            <div class="cal-stat-indicator cancelled"></div>
            <div>
                <div class="cal-stat-count" id="stat-cancelled">—</div>
                <div class="cal-stat-label">Cancelled</div>
            </div>
        </div>
        <div class="cal-stat">
            <div class="cal-stat-indicator noshow"></div>
            <div>
                <div class="cal-stat-count" id="stat-noshow">—</div>
                <div class="cal-stat-label">No Show</div>
            </div>
        </div>
        <div class="cal-stat cal-stat-total">
            <div class="cal-stat-indicator total"></div>
            <div>
                <div class="cal-stat-count" id="stat-total">—</div>
                <div class="cal-stat-label">Total</div>
            </div>
        </div>
    </div>

    <!-- Calendar -->
    <section class="cal-card">
        <div id="calendar"></div>
    </section>

</div>

<!-- ==============================
     Appointment Details Modal
     ============================== -->
<div class="cal-modal-overlay" id="detailsModal">
    <div class="cal-modal-panel">

        <div class="cal-modal-header">
            <div class="cal-modal-header-content">
                <div class="cal-modal-header-icon">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h2 class="cal-modal-title" id="modalTitle">Appointment Details</h2>
            </div>
            <button type="button" class="cal-modal-close" id="closeDetailsBtn" aria-label="Close">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- View Mode (dynamically filled) -->
        <div class="cal-modal-body" id="viewMode"></div>

        <!-- Edit Mode -->
        <div class="cal-modal-body" id="editMode" style="display:none;">
            <form asp-action="Edit" method="post" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="EditId" name="Id" />

                <div class="cal-form-group">
                    <label class="cal-form-label">Patient</label>
                    <input type="text" id="EditPatientName" class="cal-form-input" readonly />
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Doctor</label>
                    <select id="EditDoctorId" name="DoctorId" asp-items="Model.Doctors" class="cal-form-select" required>
                        <option value="">— Select Doctor —</option>
                    </select>
                </div>

                <div class="cal-form-row">
                    <div class="cal-form-group">
                        <label class="cal-form-label">Start Time</label>
                        <input id="EditStartTime" name="StartTime" type="datetime-local" class="cal-form-input" required />
                    </div>
                    <div class="cal-form-group">
                        <label class="cal-form-label">End Time</label>
                        <input id="EditEndTime" name="EndTime" type="datetime-local" class="cal-form-input" required />
                    </div>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Status</label>
                    <select id="EditStatus" name="Status" class="cal-form-select" required>
                        <option value="1">Scheduled</option>
                        <option value="2">Completed</option>
                        <option value="3">Cancelled</option>
                        <option value="4">No Show</option>
                    </select>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Reason for Visit</label>
                    <textarea id="EditReasonForVisit" name="ReasonForVisit" class="cal-form-textarea" rows="2"></textarea>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Notes</label>
                    <textarea id="EditNotes" name="Notes" class="cal-form-textarea" rows="2"></textarea>
                </div>
            </form>
        </div>

        <!-- Footer (dynamically filled) -->
        <div class="cal-modal-footer" id="detailsActions"></div>

    </div>
</div>

<!-- ==============================
     Create Appointment Modal
     ============================== -->
<div class="modal-overlay" id="appointmentModal" style="display:none;">
    <div class="cal-create-panel" onclick="event.stopPropagation()">

        <div class="cal-modal-header">
            <div class="cal-modal-header-content">
                <div class="cal-modal-header-icon">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                    </svg>
                </div>
                <h2 class="cal-modal-title">New Appointment</h2>
            </div>
            <button type="button" class="cal-modal-close" id="closeModalBtn" aria-label="Close">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <div class="cal-modal-body cal-create-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Patient Type Toggle -->
                <div class="cal-patient-toggle">
                    <label class="cal-toggle-option">
                        <input type="radio" name="NewAppointment.IsNewPatient" value="false" checked id="existingPatientRadio" />
                        <span class="cal-toggle-pill">Existing Patient</span>
                    </label>
                    <label class="cal-toggle-option">
                        <input type="radio" name="NewAppointment.IsNewPatient" value="true" id="newPatientRadio" />
                        <span class="cal-toggle-pill">New Patient</span>
                    </label>
                </div>

                <!-- Existing Patient -->
                <div id="existing-patient-section">
                    <div class="cal-form-group">
                        <label class="cal-form-label">Patient</label>
                        <select asp-for="NewAppointment.ExistingPatientId" asp-items="Model.Patients"
                                class="cal-form-select" id="ExistingPatientId">
                            <option value="">— Select Patient —</option>
                        </select>
                    </div>
                </div>

                <!-- New Patient -->
                <div id="new-patient-section" style="display:none;">
                    <div class="cal-section-heading">Patient Details</div>
                    <div class="cal-form-row">
                        <div class="cal-form-group">
                            <label class="cal-form-label">First Name *</label>
                            <input name="NewAppointment.NewPatientFirstName" class="cal-form-input" placeholder="First name" />
                        </div>
                        <div class="cal-form-group">
                            <label class="cal-form-label">Last Name *</label>
                            <input name="NewAppointment.NewPatientLastName" class="cal-form-input" placeholder="Last name" />
                        </div>
                    </div>
                    <div class="cal-form-row">
                        <div class="cal-form-group">
                            <label class="cal-form-label">Phone *</label>
                            <input name="NewAppointment.NewPatientPhone" class="cal-form-input" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="cal-form-group">
                            <label class="cal-form-label">Gender</label>
                            <select name="NewAppointment.NewPatientGender" class="cal-form-select">
                                <option value="">— Select —</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="cal-form-group">
                        <label class="cal-form-label">Date of Birth</label>
                        <input name="NewAppointment.NewPatientDateOfBirth" type="date" class="cal-form-input" />
                    </div>
                </div>

                <div class="cal-section-divider"></div>

                <div class="cal-form-row">
                    <div class="cal-form-group">
                        <label class="cal-form-label">Start Time</label>
                        <input name="NewAppointment.StartTime" type="datetime-local" class="cal-form-input" id="StartTime" />
                    </div>
                    <div class="cal-form-group">
                        <label class="cal-form-label">End Time</label>
                        <input name="NewAppointment.EndTime" type="datetime-local" class="cal-form-input" id="EndTime" />
                    </div>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Doctor</label>
                    <select name="NewAppointment.DoctorId" class="cal-form-select" id="DoctorId">
                        <option value="">— Select time first —</option>
                    </select>
                    <span class="cal-doctor-note" id="doctorAvailabilityNote"></span>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Reason for Visit</label>
                    <textarea name="NewAppointment.ReasonForVisit" class="cal-form-textarea" rows="2"
                              placeholder="Brief description…"></textarea>
                </div>

                <div class="cal-form-group">
                    <label class="cal-form-label">Notes</label>
                    <textarea name="NewAppointment.Notes" class="cal-form-textarea" rows="2"
                              placeholder="Additional notes…"></textarea>
                </div>

                <div class="cal-modal-footer">
                    <button type="button" class="cal-btn cal-btn-ghost" id="cancelModalBtn">Cancel</button>
                    <button type="submit" class="cal-btn cal-btn-primary">Save Appointment</button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
    <script>
        window.appEndpoints = {
            getDoctors:          '@Url.Action("GetDoctorsListAsync",  "Appointments")',
            getAvailableDoctors: '@Url.Action("GetAvailableDoctors",  "Appointments")',
            getAppointment:      '@Url.Action("GetAppointment",       "Appointments")'
        };
    </script>
    <script src="~/js/calendar.js"></script>
}
